<Panel class="glass-pip-panel" id="glass-pip-root">
  <style>
    .glass-pip-panel {
      flex-direction: column;
      width: 340px;
      height: 310px;
      padding: 16px;
      border-radius: 24px;
      background-color: rgba(11, 16, 32, 0.78);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.16);
      gap: 10px;
    }

    .panel-handle {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 10px;
      margin-bottom: 2px;
    }

    .handle-bar {
      width: 48px;
      height: 4px;
      border-radius: 999px;
      background-color: rgba(255, 255, 255, 0.28);
    }

    .pip-header {
      flex-direction: column;
      gap: 2px;
    }

    .pip-title-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .pip-title {
      font-size: 18px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .pip-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background-color: #06B6D4;
    }

    .pip-subtitle {
      font-size: 12px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.70);
    }

    .pip-stage-area {
      flex-direction: column;
      height: 110px;
      border-radius: 16px;
      background-color: rgba(18, 25, 48, 0.65);
      border-width: 1px;
      border-color: rgba(6, 182, 212, 0.25);
      align-items: center;
      justify-content: flex-end;
      padding-bottom: 12px;
      padding-left: 12px;
      padding-right: 12px;
    }

    .pip-speech-bubble {
      flex-direction: row;
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 6px;
      padding-bottom: 6px;
      border-radius: 12px;
      background-color: rgba(11, 16, 32, 0.90);
      border-width: 1px;
      border-color: rgba(6, 182, 212, 0.40);
      max-width: 290px;
    }

    .pip-speech-text {
      font-size: 12px;
      font-weight: 500;
      color: #E0F2FE;
    }

    .pip-chips-row {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px;
      justify-content: center;
      padding-top: 2px;
    }

    .pip-chip-btn {
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 4px;
      padding-bottom: 4px;
      border-radius: 999px;
      background-color: rgba(255, 255, 255, 0.08);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.15);
      align-items: center;
      justify-content: center;
    }

    .pip-chip-text {
      font-size: 11px;
      font-weight: 600;
      color: #E2E8F0;
    }
  </style>

  <div class="panel-handle">
    <div class="handle-bar"></div>
  </div>

  <div class="pip-header">
    <div class="pip-title-row">
      <span class="pip-title">Pip</span>
      <div class="pip-status-dot"></div>
    </div>
    <span class="pip-subtitle">Your Productivity Companion</span>
  </div>

  <div class="pip-stage-area">
    <div class="pip-speech-bubble">
      <span id="pip-speech-text" class="pip-speech-text">Ready to focus! Finish ML assignment is up next.</span>
    </div>
  </div>

  <div class="pip-chips-row">
    <Button id="chip-pip-what-next" class="pip-chip-btn">
      <ButtonLabel class="pip-chip-text">What next?</ButtonLabel>
    </Button>
    <Button id="chip-pip-plan-day" class="pip-chip-btn">
      <ButtonLabel class="pip-chip-text">Plan my day</ButtonLabel>
    </Button>
    <Button id="chip-pip-recap" class="pip-chip-btn">
      <ButtonLabel class="pip-chip-text">Recap</ButtonLabel>
    </Button>
    <Button id="chip-pip-break" class="pip-chip-btn">
      <ButtonLabel class="pip-chip-text">Take a break</ButtonLabel>
    </Button>
  </div>
</Panel>
