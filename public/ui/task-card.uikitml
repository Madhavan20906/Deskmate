<style>
  .task-root {
    flex-direction: column;
    gap: 6px;
    width: 250px;
    border-radius: 16px;
    border-width: 2px;
    border-color: #38bdf8;
    background-color: #1e293b;
    padding-bottom: 10px;
  }

  .content {
    flex-direction: column;
    gap: 4px;
    padding-top: 10px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
  }

  .eyebrow {
    color: #38bdf8;
    font-size: 13px;
    font-weight: 700;
  }

  .title {
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
  }

  .description {
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 500;
  }

  .card-btn-row {
    flex-direction: row;
    gap: 8px;
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 2px;
  }

  .action-btn {
    flex-grow: 1;
    background-color: #0284c7;
    border-radius: 999px;
    border-width: 1px;
    border-color: #38bdf8;
    padding-top: 6px;
    padding-bottom: 6px;
  }

  .status-button {
    flex-grow: 1;
    background-color: #0284c7;
    border-radius: 999px;
    border-width: 1px;
    border-color: #38bdf8;
    padding-top: 6px;
    padding-bottom: 6px;
  }

  .focus-start-button {
    flex-grow: 1;
    background-color: #059669;
    border-radius: 999px;
    border-width: 1px;
    border-color: #34d399;
    padding-top: 6px;
    padding-bottom: 6px;
  }

  .btn-label-bold {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
  }

  .focus-panel {
    flex-direction: column;
    gap: 6px;
    margin-left: 12px;
    margin-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 12px;
    background-color: #0f1d24;
    border-width: 1px;
    border-color: #1e3a47;
  }

  .focus-session-state {
    color: #38bdf8;
    font-size: 12px;
    font-weight: 700;
  }

  .focus-session-timer {
    color: #ffffff;
    font-size: 32px;
    font-weight: 800;
  }

  .focus-session-controls {
    flex-direction: row;
    gap: 6px;
  }

  .focus-session-button {
    flex-grow: 1;
    background-color: #334155;
    border-radius: 999px;
    border-width: 1px;
    border-color: #94a3b8;
    padding-top: 6px;
    padding-bottom: 6px;
  }

  .focus-btn-label {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
  }

  .secondary-actions {
    flex-direction: row;
    justify-content: space-between;
    gap: 8px;
    margin-left: 14px;
    margin-right: 14px;
    margin-bottom: 12px;
  }

  .duplicate-button {
    flex-grow: 1;
  }

  .small-button {
    flex-grow: 1;
  }
</style>
<Panel id="task-root" class="task-root">
  <div class="content">
    <span id="task-priority" class="eyebrow">MEDIUM PRIORITY / 30 MIN</span>
    <span id="task-title" class="title">New task</span>
    <span id="task-description" class="description">Add a short description.</span>
  </div>
  <div class="card-btn-row">
    <Button id="task-status" class="status-button">
      <ButtonLabel id="task-status-label" class="btn-label-bold">Start</ButtonLabel>
    </Button>
    <Button id="task-focus-start" class="focus-start-button">
      <ButtonLabel class="btn-label-bold">Focus</ButtonLabel>
    </Button>
  </div>
  <div id="task-focus-panel" class="focus-panel" style="display: none">
    <span id="task-focus-state" class="focus-session-state">FOCUS SESSION</span>
    <span id="task-focus-timer" class="focus-session-timer">25:00</span>
    <div class="focus-session-controls">
      <Button id="task-focus-pause" class="focus-session-button">
        <ButtonLabel class="focus-btn-label">Pause</ButtonLabel>
      </Button>
      <Button id="task-focus-resume" class="focus-session-button" style="display: none">
        <ButtonLabel class="focus-btn-label">Resume</ButtonLabel>
      </Button>
      <Button id="task-focus-stop" class="focus-session-button">
        <ButtonLabel class="focus-btn-label">Stop</ButtonLabel>
      </Button>
    </div>
    <div class="focus-session-controls">
      <Button id="task-focus-complete" class="focus-session-button" style="display: none">
        <ButtonLabel>Mark done</ButtonLabel>
      </Button>
      <Button id="task-focus-continue" class="focus-session-button" style="display: none">
        <ButtonLabel>Continue</ButtonLabel>
      </Button>
      <Button id="task-focus-again" class="focus-session-button" style="display: none">
        <ButtonLabel>Again</ButtonLabel>
      </Button>
    </div>
  </div>
  <div class="secondary-actions" style="display: none">
    <Button id="task-select" class="small-button">
      <ButtonLabel>Select</ButtonLabel>
    </Button>
    <Button id="task-edit" class="small-button">
      <ButtonLabel>Edit</ButtonLabel>
    </Button>
    <Button id="task-delete" class="small-button">
      <ButtonLabel>Delete</ButtonLabel>
    </Button>
  </div>
</Panel>