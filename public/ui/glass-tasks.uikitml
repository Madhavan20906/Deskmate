<Panel class="glass-panel" id="glass-tasks-root">
  <style>
    .glass-panel {
      flex-direction: column;
      width: 360px;
      height: 580px;
      padding: 16px;
      border-radius: 24px;
      background-color: rgba(11, 16, 32, 0.78);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.16);
      gap: 12px;
    }

    .panel-handle {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 8px;
      margin-bottom: 2px;
    }

    .handle-bar {
      width: 48px;
      height: 4px;
      border-radius: 999px;
      background-color: rgba(255, 255, 255, 0.28);
    }

    .tasks-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 2px;
    }

    .tasks-title-group {
      flex-direction: column;
      gap: 2px;
    }

    .tasks-title {
      font-size: 19px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .tasks-subtitle {
      font-size: 12px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.70);
    }

    .tasks-badge {
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 4px;
      padding-bottom: 4px;
      border-radius: 999px;
      background-color: rgba(124, 92, 255, 0.20);
      border-width: 1px;
      border-color: rgba(124, 92, 255, 0.50);
    }

    .tasks-badge-text {
      font-size: 12px;
      font-weight: 600;
      color: #A78BFA;
    }

    .task-list {
      flex-direction: column;
      gap: 8px;
      width: 100%;
    }

    .task-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 8px;
      padding-bottom: 8px;
      border-radius: 16px;
      background-color: rgba(18, 25, 48, 0.82);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.12);
      gap: 8px;
      width: 100%;
    }

    .checkbox-btn {
      width: 30px;
      min-width: 30px;
      max-width: 30px;
      height: 30px;
      min-height: 30px;
      max-height: 30px;
      flex-shrink: 0;
      border-radius: 999px;
      border-width: 2px;
      border-color: rgba(255, 255, 255, 0.40);
      background-color: rgba(255, 255, 255, 0.05);
      align-items: center;
      justify-content: center;
      padding: 0px;
    }

    .check-mark {
      font-size: 15px;
      font-weight: 800;
      color: #22C55E;
    }

    .task-row-main {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-grow: 1;
      padding-left: 4px;
      padding-right: 4px;
      background-color: transparent;
      gap: 6px;
    }

    .task-info {
      flex-direction: column;
      gap: 2px;
      flex-grow: 1;
      max-width: 175px;
    }

    .task-name {
      font-size: 14px;
      font-weight: 600;
      color: #FFFFFF;
    }

    .task-time-hint {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.65);
    }

    .priority-pill {
      padding-left: 8px;
      padding-right: 8px;
      padding-top: 3px;
      padding-bottom: 3px;
      border-radius: 999px;
      border-width: 1px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
    }

    .priority-pill-high {
      background-color: rgba(239, 68, 68, 0.22);
      border-color: rgba(239, 68, 68, 0.55);
    }

    .priority-pill-medium {
      background-color: rgba(245, 158, 11, 0.22);
      border-color: rgba(245, 158, 11, 0.55);
    }

    .priority-pill-low {
      background-color: rgba(59, 130, 246, 0.22);
      border-color: rgba(59, 130, 246, 0.55);
    }

    .pill-text-high {
      font-size: 11px;
      font-weight: 700;
      color: #F87171;
    }

    .pill-text-medium {
      font-size: 11px;
      font-weight: 700;
      color: #FBBF24;
    }

    .pill-text-low {
      font-size: 11px;
      font-weight: 700;
      color: #60A5FA;
    }

    .add-task-btn {
      flex-direction: row;
      width: 100%;
      height: 44px;
      border-radius: 999px;
      background-color: rgba(124, 92, 255, 0.25);
      border-width: 1px;
      border-color: rgba(124, 92, 255, 0.60);
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .add-task-text {
      font-size: 14px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .undo-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-left: 12px;
      padding-right: 12px;
      padding-top: 4px;
      padding-bottom: 4px;
      border-radius: 12px;
      background-color: rgba(124, 92, 255, 0.18);
      border-width: 1px;
      border-color: rgba(124, 92, 255, 0.40);
      width: 100%;
    }

    .undo-text {
      font-size: 12px;
      font-weight: 600;
      color: #E0E7FF;
    }

    .undo-action-btn {
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 3px;
      padding-bottom: 3px;
      border-radius: 999px;
      background-color: #7C5CFF;
      align-items: center;
      justify-content: center;
    }

    .undo-action-text {
      font-size: 11px;
      font-weight: 700;
      color: #FFFFFF;
    }
  </style>

  <div class="panel-handle">
    <div class="handle-bar"></div>
  </div>

  <div class="tasks-header">
    <div class="tasks-title-group">
      <span class="tasks-title">Today's Tasks</span>
      <span class="tasks-subtitle">Organized by priority</span>
    </div>
    <div class="tasks-badge">
      <span id="tasks-count-badge" class="tasks-badge-text">4 Active</span>
    </div>
  </div>

  <div class="task-list">
    <div class="task-row">
      <Button id="task-chk-0" class="checkbox-btn">
        <ButtonLabel id="task-chk-lbl-0" class="check-mark"></ButtonLabel>
      </Button>
      <Button id="task-row-0" class="task-row-main">
        <div class="task-info">
          <ButtonLabel id="task-title-0" class="task-name">Finish ML assignment</ButtonLabel>
          <span id="task-time-0" class="task-time-hint">09:00 - 10:30</span>
        </div>
        <div class="priority-pill priority-pill-high">
          <span id="task-pill-text-0" class="pill-text-high">High, 1h 30m</span>
        </div>
      </Button>
    </div>

    <div class="task-row">
      <Button id="task-chk-1" class="checkbox-btn">
        <ButtonLabel id="task-chk-lbl-1" class="check-mark"></ButtonLabel>
      </Button>
      <Button id="task-row-1" class="task-row-main">
        <div class="task-info">
          <ButtonLabel id="task-title-1" class="task-name">Implement API</ButtonLabel>
          <span id="task-time-1" class="task-time-hint">11:00 - 13:00</span>
        </div>
        <div class="priority-pill priority-pill-medium">
          <span id="task-pill-text-1" class="pill-text-medium">Medium, 2h</span>
        </div>
      </Button>
    </div>

    <div class="task-row">
      <Button id="task-chk-2" class="checkbox-btn">
        <ButtonLabel id="task-chk-lbl-2" class="check-mark"></ButtonLabel>
      </Button>
      <Button id="task-row-2" class="task-row-main">
        <div class="task-info">
          <ButtonLabel id="task-title-2" class="task-name">Team meeting</ButtonLabel>
          <span id="task-time-2" class="task-time-hint">14:00 - 14:30</span>
        </div>
        <div class="priority-pill priority-pill-low">
          <span id="task-pill-text-2" class="pill-text-low">Low, 30m</span>
        </div>
      </Button>
    </div>

    <div class="task-row">
      <Button id="task-chk-3" class="checkbox-btn">
        <ButtonLabel id="task-chk-lbl-3" class="check-mark"></ButtonLabel>
      </Button>
      <Button id="task-row-3" class="task-row-main">
        <div class="task-info">
          <ButtonLabel id="task-title-3" class="task-name">Read research paper</ButtonLabel>
          <span id="task-time-3" class="task-time-hint">15:00 - 16:00</span>
        </div>
        <div class="priority-pill priority-pill-medium">
          <span id="task-pill-text-3" class="pill-text-medium">Medium, 1h</span>
        </div>
      </Button>
    </div>
  </div>

  <Button id="btn-add-task" class="add-task-btn">
    <ButtonIcon>
      <Plus color="#FFFFFF"></Plus>
    </ButtonIcon>
    <ButtonLabel class="add-task-text">+ Add Task</ButtonLabel>
  </Button>

  <div id="undo-container" class="undo-bar" style="display: none">
    <span id="undo-label" class="undo-text">Action completed</span>
    <Button id="undo-btn" class="undo-action-btn">
      <ButtonLabel class="undo-action-text">Undo (8s)</ButtonLabel>
    </Button>
  </div>
</Panel>
