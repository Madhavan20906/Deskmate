<Panel class="glass-panel" id="glass-tasks-root">
  <style>
    .glass-panel {
      flex-direction: column;
      width: 360px;
      height: 660px;
      padding: 18px;
      border-radius: 24px;
      background-color: rgba(11, 16, 32, 0.78);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.16);
      gap: 14px;
    }

    .panel-handle {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 12px;
      margin-bottom: 2px;
    }

    .handle-bar {
      width: 48px;
      height: 4px;
      border-radius: 999px;
      background-color: rgba(255, 255, 255, 0.28);
    }

    .tasks-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 4px;
    }

    .tasks-title-group {
      flex-direction: column;
      gap: 2px;
    }

    .tasks-title {
      font-size: 20px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .tasks-subtitle {
      font-size: 13px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.70);
    }

    .tasks-badge {
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 4px;
      padding-bottom: 4px;
      border-radius: 999px;
      background-color: rgba(124, 92, 255, 0.20);
      border-width: 1px;
      border-color: rgba(124, 92, 255, 0.50);
    }

    .tasks-badge-text {
      font-size: 12px;
      font-weight: 600;
      color: #A78BFA;
    }

    .task-list {
      flex-direction: column;
      flex-grow: 1;
      gap: 10px;
    }

    .task-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 12px;
      border-radius: 16px;
      background-color: rgba(18, 25, 48, 0.82);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.12);
      gap: 10px;
    }

    .task-row-left {
      flex-direction: row;
      align-items: center;
      gap: 10px;
      flex-grow: 1;
    }

    .checkbox-btn {
      width: 28px;
      height: 28px;
      border-radius: 999px;
      border-width: 2px;
      border-color: rgba(255, 255, 255, 0.35);
      background-color: transparent;
      align-items: center;
      justify-content: center;
    }

    .checkbox-btn-done {
      width: 28px;
      height: 28px;
      border-radius: 999px;
      border-width: 2px;
      border-color: #22C55E;
      background-color: #22C55E;
      align-items: center;
      justify-content: center;
    }

    .check-mark {
      font-size: 15px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .task-info {
      flex-direction: column;
      gap: 2px;
    }

    .task-name {
      font-size: 15px;
      font-weight: 600;
      color: #FFFFFF;
    }

    .task-name-done {
      font-size: 15px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.45);
    }

    .task-time-hint {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.60);
    }

    .priority-pill {
      padding-left: 8px;
      padding-right: 8px;
      padding-top: 3px;
      padding-bottom: 3px;
      border-radius: 999px;
      border-width: 1px;
    }

    .priority-pill-high {
      background-color: rgba(239, 68, 68, 0.22);
      border-color: rgba(239, 68, 68, 0.55);
    }

    .priority-pill-medium {
      background-color: rgba(245, 158, 11, 0.22);
      border-color: rgba(245, 158, 11, 0.55);
    }

    .priority-pill-low {
      background-color: rgba(59, 130, 246, 0.22);
      border-color: rgba(59, 130, 246, 0.55);
    }

    .pill-text-high {
      font-size: 11px;
      font-weight: 700;
      color: #F87171;
    }

    .pill-text-medium {
      font-size: 11px;
      font-weight: 700;
      color: #FBBF24;
    }

    .pill-text-low {
      font-size: 11px;
      font-weight: 700;
      color: #60A5FA;
    }

    .add-task-btn {
      flex-direction: row;
      width: 100%;
      height: 48px;
      border-radius: 999px;
      background-color: rgba(124, 92, 255, 0.25);
      border-width: 1px;
      border-color: rgba(124, 92, 255, 0.60);
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .add-task-text {
      font-size: 15px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .undo-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-left: 12px;
      padding-right: 12px;
      padding-top: 6px;
      padding-bottom: 6px;
      border-radius: 12px;
      background-color: rgba(30, 41, 59, 0.90);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.20);
    }

    .undo-text {
      font-size: 12px;
      color: #E2E8F0;
    }

    .undo-btn {
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 3px;
      padding-bottom: 3px;
      border-radius: 999px;
      background-color: #7C5CFF;
    }

    .undo-btn-text {
      font-size: 12px;
      font-weight: 700;
      color: #FFFFFF;
    }
  </style>

  <div class="panel-handle">
    <div class="handle-bar"></div>
  </div>

  <div class="tasks-header">
    <div class="tasks-title-group">
      <span class="tasks-title">Today's Tasks</span>
      <span id="tasks-active-subtitle" class="tasks-subtitle">Organized by priority</span>
    </div>
    <div class="tasks-badge">
      <span id="tasks-count-badge" class="tasks-badge-text">4 Active</span>
    </div>
  </div>

  <div class="task-list">
    <!-- Task 1: Finish ML assignment -->
    <div id="task-row-0" class="task-row">
      <div class="task-row-left">
        <Button id="task-chk-0" class="checkbox-btn">
          <ButtonLabel id="task-chk-lbl-0" class="check-mark"></ButtonLabel>
        </Button>
        <div class="task-info">
          <span id="task-title-0" class="task-name">Finish ML assignment</span>
          <span id="task-time-0" class="task-time-hint">09:00 - 10:30</span>
        </div>
      </div>
      <div id="task-pill-0" class="priority-pill priority-pill-high">
        <span id="task-pill-text-0" class="pill-text-high">High, 1h 30m</span>
      </div>
    </div>

    <!-- Task 2: Implement API -->
    <div id="task-row-1" class="task-row">
      <div class="task-row-left">
        <Button id="task-chk-1" class="checkbox-btn">
          <ButtonLabel id="task-chk-lbl-1" class="check-mark"></ButtonLabel>
        </Button>
        <div class="task-info">
          <span id="task-title-1" class="task-name">Implement API</span>
          <span id="task-time-1" class="task-time-hint">11:00 - 13:00</span>
        </div>
      </div>
      <div id="task-pill-1" class="priority-pill priority-pill-medium">
        <span id="task-pill-text-1" class="pill-text-medium">Medium, 2h</span>
      </div>
    </div>

    <!-- Task 3: Team meeting -->
    <div id="task-row-2" class="task-row">
      <div class="task-row-left">
        <Button id="task-chk-2" class="checkbox-btn">
          <ButtonLabel id="task-chk-lbl-2" class="check-mark"></ButtonLabel>
        </Button>
        <div class="task-info">
          <span id="task-title-2" class="task-name">Team meeting</span>
          <span id="task-time-2" class="task-time-hint">14:00 - 14:30</span>
        </div>
      </div>
      <div id="task-pill-2" class="priority-pill priority-pill-low">
        <span id="task-pill-text-2" class="pill-text-low">Low, 30m</span>
      </div>
    </div>

    <!-- Task 4: Read research paper -->
    <div id="task-row-3" class="task-row">
      <div class="task-row-left">
        <Button id="task-chk-3" class="checkbox-btn">
          <ButtonLabel id="task-chk-lbl-3" class="check-mark"></ButtonLabel>
        </Button>
        <div class="task-info">
          <span id="task-title-3" class="task-name">Read research paper</span>
          <span id="task-time-3" class="task-time-hint">15:00 - 16:00</span>
        </div>
      </div>
      <div id="task-pill-3" class="priority-pill priority-pill-medium">
        <span id="task-pill-text-3" class="pill-text-medium">Medium, 1h</span>
      </div>
    </div>
  </div>

  <div id="undo-container" class="undo-bar" style="display: none">
    <span id="undo-label" class="undo-text">Change saved</span>
    <Button id="undo-btn" class="undo-btn">
      <ButtonLabel class="undo-btn-text">Undo</ButtonLabel>
    </Button>
  </div>

  <Button id="btn-add-task" class="add-task-btn">
    <ButtonLabel class="add-task-text">+ Add Task</ButtonLabel>
  </Button>
</Panel>
