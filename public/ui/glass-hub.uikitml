<Panel class="glass-hub-panel" id="glass-hub-root">
  <style>
    .glass-hub-panel {
      flex-direction: column;
      width: 780px;
      height: 720px;
      padding: 14px;
      border-radius: 24px;
      background-color: rgba(11, 16, 32, 0.88);
      border-width: 1.5px;
      border-color: rgba(255, 255, 255, 0.18);
      gap: 8px;
    }

    .panel-handle {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 6px;
      margin-bottom: 1px;
    }

    .handle-bar {
      width: 56px;
      height: 4px;
      border-radius: 999px;
      background-color: rgba(255, 255, 255, 0.28);
    }

    .hub-zoom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 6px;
      padding-bottom: 6px;
      border-radius: 12px;
      background-color: rgba(124, 92, 255, 0.25);
      border-width: 1.5px;
      border-color: #7C5CFF;
      width: 100%;
    }

    .zoom-back-btn {
      flex-direction: row;
      align-items: center;
      gap: 6px;
      padding-left: 10px;
      padding-right: 12px;
      padding-top: 4px;
      padding-bottom: 4px;
      border-radius: 8px;
      background-color: #7C5CFF;
      border-width: 1px;
      border-color: #DDD6FE;
    }

    .zoom-back-btn:hover {
      background-color: #906FFA;
      border-color: #FFFFFF;
    }

    .zoom-back-text {
      font-size: 12px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .zoom-section-title {
      font-size: 13px;
      font-weight: 700;
      color: #E0E7FF;
    }

    .hub-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding-bottom: 2px;
    }

    .header-time-group {
      flex-direction: row;
      align-items: center;
      gap: 12px;
      min-width: 210px;
    }

    .time-date-stack {
      flex-direction: column;
      gap: 1px;
    }

    .header-date {
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.75);
    }

    .header-time {
      font-size: 24px;
      font-weight: 800;
      color: #FFFFFF;
      line-height: 26px;
    }

    .weather-pill-btn {
      flex-direction: row;
      align-items: center;
      gap: 6px;
      padding-left: 8px;
      padding-right: 8px;
      padding-top: 4px;
      padding-bottom: 4px;
      border-radius: 12px;
      background-color: rgba(255, 255, 255, 0.08);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.15);
    }

    .weather-pill-btn:hover {
      background-color: rgba(255, 255, 255, 0.18);
      border-color: #F59E0B;
    }

    .weather-icon {
      font-size: 16px;
    }

    .weather-text-stack {
      flex-direction: column;
      gap: 0px;
    }

    .weather-temp {
      font-size: 12px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .weather-city {
      font-size: 10px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.65);
    }

    .header-center-group {
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }

    .brand-group {
      flex-direction: row;
      align-items: center;
      gap: 6px;
    }

    .brand-cube {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background-color: #7C5CFF;
      align-items: center;
      justify-content: center;
    }

    .brand-title {
      font-size: 17px;
      font-weight: 800;
      color: #FFFFFF;
      letter-spacing: 0.4px;
    }

    .brand-tagline {
      font-size: 11px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.65);
    }

    .header-actions-group {
      flex-direction: row;
      align-items: center;
      gap: 6px;
      min-width: 160px;
      justify-content: flex-end;
    }

    .icon-action-btn {
      width: 32px;
      height: 32px;
      border-radius: 999px;
      background-color: rgba(255, 255, 255, 0.08);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.15);
      align-items: center;
      justify-content: center;
      padding: 0px;
    }

    .icon-action-btn:hover {
      background-color: rgba(255, 255, 255, 0.22);
      border-color: rgba(255, 255, 255, 0.50);
    }

    .icon-action-btn:active {
      background-color: rgba(124, 92, 255, 0.45);
      border-color: #A78BFA;
    }

    .icon-text {
      font-size: 13px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .badge-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background-color: #EF4444;
      margin-left: 2px;
      margin-top: -6px;
    }

    .hero-banner-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding-top: 1px;
      padding-bottom: 1px;
    }

    .greeting-group {
      flex-direction: column;
      gap: 1px;
    }

    .greeting-title {
      font-size: 19px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .greeting-subtitle {
      font-size: 12px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.75);
    }

    .pip-speech-banner {
      flex-direction: row;
      align-items: center;
      gap: 8px;
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 5px;
      padding-bottom: 5px;
      border-radius: 12px;
      background-color: rgba(18, 25, 48, 0.90);
      border-width: 1px;
      border-color: rgba(6, 182, 212, 0.35);
    }

    .pip-speech-banner:hover {
      border-color: #06B6D4;
      background-color: rgba(6, 182, 212, 0.15);
    }

    .pip-banner-text {
      font-size: 12px;
      font-weight: 600;
      color: #E0F2FE;
    }

    .nav-tabs-bar {
      flex-direction: row;
      justify-content: space-between;
      gap: 4px;
      width: 100%;
    }

    .nav-tab-pill {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 5px;
      flex-grow: 1;
      height: 34px;
      border-radius: 10px;
      background-color: rgba(255, 255, 255, 0.05);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.10);
      padding-left: 6px;
      padding-right: 6px;
    }

    .nav-tab-pill:hover {
      background-color: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.30);
    }

    .nav-tab-active {
      background-color: rgba(124, 92, 255, 0.22);
      border-color: #7C5CFF;
      border-width: 1.5px;
    }

    .nav-tab-label {
      font-size: 11px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
    }

    .nav-tab-label-active {
      font-size: 11px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .schedule-card {
      flex-direction: column;
      width: 100%;
      height: 156px;
      padding: 10px;
      border-radius: 16px;
      background-color: rgba(18, 25, 48, 0.85);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.12);
      gap: 6px;
    }

    .schedule-card-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }

    .schedule-title {
      font-size: 14px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .schedule-controls {
      flex-direction: row;
      align-items: center;
      gap: 6px;
    }

    .schedule-view-tabs {
      flex-direction: row;
      gap: 2px;
      border-radius: 8px;
      background-color: rgba(255, 255, 255, 0.06);
      padding: 2px;
    }

    .sched-view-btn {
      padding-left: 8px;
      padding-right: 8px;
      padding-top: 2px;
      padding-bottom: 2px;
      border-radius: 6px;
      background-color: transparent;
      border-width: 0px;
    }

    .sched-view-btn-active {
      background-color: #3B82F6;
    }

    .sched-view-text {
      font-size: 11px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.75);
    }

    .sched-view-text-active {
      font-size: 11px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .sched-action-btn {
      padding-left: 8px;
      padding-right: 8px;
      padding-top: 3px;
      padding-bottom: 3px;
      border-radius: 6px;
      background-color: rgba(255, 255, 255, 0.08);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.15);
      align-items: center;
      justify-content: center;
    }

    .sched-action-btn:hover {
      background-color: rgba(124, 92, 255, 0.35);
      border-color: #A78BFA;
    }

    .sched-action-text {
      font-size: 11px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .timeline-container {
      flex-direction: column;
      width: 100%;
      flex-grow: 1;
      justify-content: center;
      gap: 2px;
    }

    .now-marker-row {
      flex-direction: row;
      width: 100%;
      height: 18px;
      align-items: center;
    }

    .now-marker-badge {
      padding-left: 6px;
      padding-right: 6px;
      padding-top: 1px;
      padding-bottom: 1px;
      border-radius: 999px;
      background-color: #8B5CF6;
      border-width: 1px;
      border-color: #DDD6FE;
    }

    .now-marker-text {
      font-size: 10px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .timeline-axis-labels {
      flex-direction: row;
      justify-content: space-between;
      width: 100%;
      padding-left: 2px;
      padding-right: 2px;
    }

    .axis-label {
      font-size: 10px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.55);
    }

    .timeline-track {
      flex-direction: row;
      width: 100%;
      height: 52px;
      border-radius: 10px;
      background-color: rgba(255, 255, 255, 0.04);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.08);
      align-items: center;
      padding-left: 4px;
      padding-right: 4px;
      gap: 6px;
    }

    .schedule-block {
      flex-direction: column;
      height: 44px;
      border-radius: 8px;
      padding-left: 6px;
      padding-right: 6px;
      padding-top: 4px;
      padding-bottom: 4px;
      justify-content: center;
      gap: 1px;
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.20);
    }

    .schedule-block:hover {
      border-color: #FFFFFF;
      border-width: 2px;
    }

    .schedule-block:active {
      border-color: #C4B5FD;
      border-width: 2px;
    }

    .block-title {
      font-size: 11px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .block-time {
      font-size: 10px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
    }

    .bottom-cards-row {
      flex-direction: row;
      justify-content: space-between;
      gap: 8px;
      width: 100%;
      flex-grow: 1;
    }

    .card-base {
      flex-direction: column;
      width: 244px;
      padding: 10px;
      border-radius: 16px;
      background-color: rgba(18, 25, 48, 0.85);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.12);
      gap: 6px;
      justify-content: space-between;
    }

    .card-header-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }

    .card-title-group {
      flex-direction: row;
      align-items: center;
      gap: 6px;
    }

    .card-title {
      font-size: 14px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .card-zoom-btn {
      padding-left: 6px;
      padding-right: 6px;
      padding-top: 2px;
      padding-bottom: 2px;
      border-radius: 6px;
      background-color: rgba(255, 255, 255, 0.08);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.15);
      align-items: center;
      justify-content: center;
    }

    .card-zoom-btn:hover {
      background-color: rgba(124, 92, 255, 0.40);
      border-color: #A78BFA;
    }

    .card-zoom-text {
      font-size: 10px;
      font-weight: 700;
      color: #E2E8F0;
    }

    .filter-chips-row {
      flex-direction: row;
      gap: 2px;
      border-radius: 8px;
      background-color: rgba(255, 255, 255, 0.05);
      padding: 2px;
    }

    .filter-chip {
      padding-left: 6px;
      padding-right: 6px;
      padding-top: 2px;
      padding-bottom: 2px;
      border-radius: 6px;
      background-color: transparent;
