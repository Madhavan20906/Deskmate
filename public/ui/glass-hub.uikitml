      color: rgba(255, 255, 255, 0.70);
    }

    .filter-chip-text-active {
      font-size: 10px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .hub-task-rows {
      flex-direction: column;
      gap: 4px;
      width: 100%;
    }

    .hub-task-item {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-left: 6px;
      padding-right: 6px;
      padding-top: 3px;
      padding-bottom: 3px;
      border-radius: 8px;
      background-color: rgba(255, 255, 255, 0.04);
      width: 100%;
    }

    .hub-task-item:hover {
      background-color: rgba(255, 255, 255, 0.10);
    }

    .hub-task-left {
      flex-direction: row;
      align-items: center;
      gap: 6px;
      flex-grow: 1;
    }

    .chk-square {
      width: 16px;
      height: 16px;
      border-radius: 4px;
      border-width: 1.5px;
      border-color: rgba(255, 255, 255, 0.35);
      align-items: center;
      justify-content: center;
    }

    .chk-square-checked {
      background-color: #22C55E;
      border-color: #22C55E;
    }

    .chk-square-mark {
      font-size: 10px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .hub-task-text {
      font-size: 11px;
      font-weight: 600;
      color: #FFFFFF;
    }

    .hub-task-text-strike {
      font-size: 11px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.40);
    }

    .hub-task-right {
      flex-direction: row;
      align-items: center;
      gap: 4px;
    }

    .hub-task-badge {
      padding-left: 4px;
      padding-right: 4px;
      padding-top: 1px;
      padding-bottom: 1px;
      border-radius: 4px;
      font-size: 9px;
      font-weight: 700;
    }

    .badge-high {
      background-color: rgba(239, 68, 68, 0.25);
      color: #F87171;
    }

    .badge-med {
      background-color: rgba(245, 158, 11, 0.25);
      color: #FBBF24;
    }

    .badge-low {
      background-color: rgba(59, 130, 246, 0.25);
      color: #60A5FA;
    }

    .task-edit-btn {
      width: 20px;
      height: 20px;
      border-radius: 4px;
      background-color: rgba(255, 255, 255, 0.08);
      align-items: center;
      justify-content: center;
    }

    .task-edit-btn:hover {
      background-color: rgba(124, 92, 255, 0.45);
    }

    .task-edit-icon {
      font-size: 10px;
    }

    .add-task-footer-btn {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 4px;
      height: 24px;
      border-radius: 8px;
      background-color: rgba(124, 92, 255, 0.15);
      border-width: 1px;
      border-color: rgba(124, 92, 255, 0.35);
      width: 100%;
    }

    .add-task-footer-btn:hover {
      background-color: #7C5CFF;
    }

    .add-task-footer-text {
      font-size: 11px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .focus-timer-body {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      flex-grow: 1;
    }

    .timer-ring-row {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
    }

    .timer-ring {
      width: 78px;
      height: 78px;
      border-radius: 999px;
      border-width: 4px;
      border-color: #7C5CFF;
      background-color: rgba(124, 92, 255, 0.12);
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 0px;
    }

    .timer-digits {
      font-size: 21px;
      font-weight: 800;
      color: #FFFFFF;
      line-height: 23px;
    }

    .timer-label {
      font-size: 9px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.65);
    }

    .hub-play-btn {
      width: 38px;
      height: 38px;
      border-radius: 999px;
      background-color: #7C5CFF;
      align-items: center;
      justify-content: center;
      border-width: 1.5px;
      border-color: rgba(255, 255, 255, 0.30);
    }

    .hub-play-btn:hover {
      background-color: #906ffa;
      border-color: #FFFFFF;
    }

    .hub-play-icon {
      font-size: 15px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .focus-quick-chips-row {
      flex-direction: row;
      justify-content: space-between;
      gap: 3px;
      width: 100%;
    }

    .focus-quick-chip {
      flex-grow: 1;
      height: 24px;
      border-radius: 6px;
      background-color: rgba(255, 255, 255, 0.08);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.15);
      align-items: center;
      justify-content: center;
      padding: 0px;
    }

    .focus-quick-chip:hover {
      background-color: rgba(124, 92, 255, 0.35);
      border-color: #A78BFA;
    }

    .focus-quick-chip:active {
      background-color: #7C5CFF;
    }

    .focus-quick-chip-text {
      font-size: 10px;
      font-weight: 700;
      color: #E2E8F0;
    }

    .focus-footer-text {
      font-size: 11px;
      font-weight: 600;
      color: #A78BFA;
      text-align: center;
    }

    .workload-body {
      flex-direction: row;
      align-items: center;
      gap: 10px;
      width: 100%;
    }

    .donut-gauge {
      width: 64px;
      height: 64px;
      border-radius: 999px;
      border-width: 5px;
      border-color: #38BDF8;
      background-color: rgba(56, 189, 248, 0.12);
