      justify-content: center;
    }

    .donut-gauge-text {
      font-size: 18px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .workload-legend {
      flex-direction: column;
      gap: 3px;
      flex-grow: 1;
    }

    .legend-row {
      flex-direction: row;
      align-items: center;
      gap: 6px;
    }

    .legend-dot-cyan {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background-color: #38BDF8;
    }

    .legend-dot-green {
      width: 8px;
      height: 8px;
