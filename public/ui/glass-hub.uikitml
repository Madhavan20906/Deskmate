 <!-- Subview: Studio Settings & Themes -->
 <div id="view-settings" class="hub-subview" style="display: none;">
 <div class="subview-top-bar">
 <Button id="btn-settings-back" class="subview-back-btn">
 <ButtonLabel class="subview-back-text">Back to Dashboard</ButtonLabel>
 </Button>
 <span class="subview-title">Spatial Studio &amp; Environment</span>
 <span class="subview-back-text" style="color: #4E8762;">Active</span>
 </div>
 <div class="subview-body" style="gap: 10px;">
 <div class="interactive-card-item" style="justify-content: space-between; align-items: center; padding: 10px;">
 <div style="flex-direction: column;">
 <span class="interactive-card-text" style="font-weight: 700;">Spatial Audio Feedback</span>
 <span class="legend-text" style="color: rgba(245, 242, 235, 0.60);">Tactile pinch ticks, focus bells, and subtle binaural room audio</span>
 </div>
 <Button id="btn-setting-audio-toggle" class="focus-quick-chip" style="background-color: #D97736; border-color: #F3B27A;">
 <ButtonLabel id="btn-setting-audio-label" class="focus-quick-chip-text">Audio: Active</ButtonLabel>
 </Button>
 </div>

 <div class="interactive-card-item" style="flex-direction: column; gap: 6px; padding: 10px;">
 <span class="interactive-card-text" style="font-weight: 700;">Desk Viewing Distance</span>
 <div style="flex-direction: row; gap: 8px; width: 100%;">
 <Button id="btn-setting-dist-near" class="focus-quick-chip" style="flex-grow: 1;"><ButtonLabel class="focus-quick-chip-text">Near (60cm)</ButtonLabel></Button>
 <Button id="btn-setting-dist-norm" class="focus-quick-chip" style="flex-grow: 1; background-color: rgba(217, 119, 54, 0.35); border-color: #D97736;"><ButtonLabel class="focus-quick-chip-text">Normal (75cm)</ButtonLabel></Button>
 <Button id="btn-setting-dist-far" class="focus-quick-chip" style="flex-grow: 1;"><ButtonLabel class="focus-quick-chip-text">Far (95cm)</ButtonLabel></Button>
 </div>
 </div>

 <div class="interactive-card-item" style="flex-direction: column; gap: 6px; padding: 10px;">
 <span class="interactive-card-text" style="font-weight: 700;">Natural Material Theme</span>
 <div style="flex-direction: row; gap: 8px; width: 100%;">
 <Button id="btn-setting-theme-glass" class="focus-quick-chip" style="flex-grow: 1; background-color: rgba(217, 119, 54, 0.35); border-color: #D97736;"><ButtonLabel class="focus-quick-chip-text">Warm Sunlit Glass</ButtonLabel></Button>
 <Button id="btn-setting-theme-titanium" class="focus-quick-chip" style="flex-grow: 1;"><ButtonLabel class="focus-quick-chip-text">Dark Titanium</ButtonLabel></Button>
 <Button id="btn-setting-theme-timber" class="focus-quick-chip" style="flex-grow: 1;"><ButtonLabel class="focus-quick-chip-text">Nordic Timber</ButtonLabel></Button>
 </div>
 </div>
 </div>
 </div>

