      background-color: rgba(245, 158, 11, 0.15);
      border-width: 1px;
      border-color: rgba(245, 158, 11, 0.35);
      width: 100%;
    }

    .workload-insight-capsule:hover {
      background-color: rgba(245, 158, 11, 0.25);
    }

    .workload-insight-text {
      font-size: 10px;
      font-weight: 600;
      color: #FDE68A;
    }

    .dock-container {
      flex-direction: row;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding-top: 2px;
    }

    .dock-btn {
      flex-direction: row;
      align-items: center;
      gap: 4px;
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 4px;
      padding-bottom: 4px;
      border-radius: 10px;
      background-color: rgba(255, 255, 255, 0.06);
