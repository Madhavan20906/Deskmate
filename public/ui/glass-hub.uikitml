  <div class="panel-handle">
    <div class="handle-bar"></div>
  </div>

  <div id="hub-zoom-bar" class="hub-zoom-bar" style="display: none;">
    <Button id="btn-zoom-back" class="zoom-back-btn">
      <ButtonLabel class="zoom-back-text">◀ Back to Overview</ButtonLabel>
    </Button>
    <span id="zoom-section-label" class="zoom-section-title">Viewing Section (Zoomed)</span>
  </div>

  <div class="hub-header">
    <div class="header-time-group">
      <div class="time-date-stack">
        <span id="hub-date" class="header-date">Tue, Nov 18</span>
        <span id="hub-time" class="header-time">10:24 AM</span>
      </div>

      <Button id="btn-weather" class="weather-pill-btn">
        <span class="weather-icon">⛅</span>
        <div class="weather-text-stack">
          <ButtonLabel id="weather-temp" class="weather-temp">28°C</ButtonLabel>
          <span id="weather-city" class="weather-city">Chennai</span>
        </div>
      </Button>
    </div>

    <div class="header-center-group">
      <div class="brand-group">
        <div class="brand-cube">
          <Bot width="13" height="13" color="#FFFFFF"></Bot>
        </div>
        <span class="brand-title">DeskMate</span>
      </div>
      <span class="brand-tagline">Your Spatial Productivity Studio</span>
    </div>

    <div class="header-actions-group">
      <Button id="btn-search" class="icon-action-btn">
        <ButtonLabel class="icon-text">🔍</ButtonLabel>
      </Button>
      <Button id="btn-bell" class="icon-action-btn">
        <ButtonLabel class="icon-text">🔔</ButtonLabel>
        <div id="bell-badge" class="badge-dot"></div>
      </Button>
      <Button id="btn-settings" class="icon-action-btn">
        <ButtonLabel class="icon-text">⚙️</ButtonLabel>
      </Button>
      <Button id="btn-profile" class="icon-action-btn">
        <ButtonLabel class="icon-text">👤</ButtonLabel>
      </Button>
    </div>
  </div>

  <div class="hero-banner-row">
    <div class="greeting-group">
      <span id="hub-greeting-text" class="greeting-title">Good Morning 👋</span>
      <span id="hub-task-summary" class="greeting-subtitle">You have 5 tasks today • 2 high priority • 6h 30m planned</span>
    </div>

    <Button id="hub-pip-banner-btn" class="pip-speech-banner">
      <ButtonLabel class="weather-icon">🤖</ButtonLabel>
      <ButtonLabel id="hub-pip-text" class="pip-banner-text">Pip: Let's plan your day. You're on track! 🚀</ButtonLabel>
    </Button>
  </div>

  <div class="nav-tabs-bar">
    <Button id="nav-tasks" class="nav-tab-pill">
      <Check width="13" height="13" color="#A78BFA"></Check>
      <ButtonLabel class="nav-tab-label">Tasks</ButtonLabel>
    </Button>

    <Button id="nav-schedule" class="nav-tab-pill nav-tab-active">
      <Calendar width="13" height="13" color="#FFFFFF"></Calendar>
      <ButtonLabel class="nav-tab-label-active">Schedule</ButtonLabel>
    </Button>

    <Button id="nav-focus" class="nav-tab-pill">
      <Play width="13" height="13" color="#FFFFFF"></Play>
      <ButtonLabel class="nav-tab-label">Focus</ButtonLabel>
    </Button>

    <Button id="nav-analytics" class="nav-tab-pill">
      <ChartColumn width="13" height="13" color="#FFFFFF"></ChartColumn>
      <ButtonLabel class="nav-tab-label">Analytics</ButtonLabel>
    </Button>

    <Button id="nav-garden" class="nav-tab-pill">
      <Sprout width="13" height="13" color="#4ADE80"></Sprout>
      <ButtonLabel class="nav-tab-label">Garden</ButtonLabel>
    </Button>

    <Button id="nav-routines" class="nav-tab-pill">
      <Clock width="13" height="13" color="#FFFFFF"></Clock>
      <ButtonLabel class="nav-tab-label">Routines</ButtonLabel>
    </Button>

    <Button id="nav-notes" class="nav-tab-pill">
      <ButtonLabel class="nav-tab-label">📝 Notes</ButtonLabel>
    </Button>

    <Button id="nav-goals" class="nav-tab-pill">
      <ButtonLabel class="nav-tab-label">🎯 Goals</ButtonLabel>
    </Button>
  </div>

  <div class="schedule-card">
    <div class="schedule-card-header">
      <span class="schedule-title">Today's Schedule (8:00 AM – 10:00 PM)</span>
      <div class="schedule-controls">
        <div class="schedule-view-tabs">
          <Button id="tab-day" class="sched-view-btn sched-view-btn-active">
            <ButtonLabel class="sched-view-text-active">Day</ButtonLabel>
          </Button>
          <Button id="tab-week" class="sched-view-btn">
            <ButtonLabel class="sched-view-text">Week</ButtonLabel>
          </Button>
          <Button id="tab-month" class="sched-view-btn">
            <ButtonLabel class="sched-view-text">Month</ButtonLabel>
          </Button>
        </div>
        <Button id="btn-add-block" class="sched-action-btn">
          <ButtonLabel class="sched-action-text">+ Block</ButtonLabel>
        </Button>
        <Button id="btn-zoom-schedule" class="sched-action-btn">
          <ButtonLabel class="sched-action-text">⛶ Zoom</ButtonLabel>
        </Button>
      </div>
    </div>

    <div class="timeline-container">
      <div class="now-marker-row">
        <div id="now-marker" class="now-marker-badge" style="margin-left: 172px;">
          <span id="now-marker-text" class="now-marker-text">10:24 AM</span>
        </div>
      </div>

      <div class="timeline-axis-labels">
        <span class="axis-label">8 AM</span>
        <span class="axis-label">9 AM</span>
        <span class="axis-label">10 AM</span>
        <span class="axis-label">11 AM</span>
        <span class="axis-label">12 PM</span>
        <span class="axis-label">1 PM</span>
        <span class="axis-label">2 PM</span>
        <span class="axis-label">3 PM</span>
        <span class="axis-label">4 PM</span>
        <span class="axis-label">5 PM</span>
        <span class="axis-label">7 PM</span>
        <span class="axis-label">8 PM</span>
        <span class="axis-label">9 PM</span>
        <span class="axis-label">10 PM</span>
      </div>

      <div id="timeline-track" class="timeline-track">
        <Button id="block-0" class="schedule-block" style="background-color: #2563EB; width: 110px; margin-left: 45px;">
          <ButtonLabel id="block-title-0" class="block-title">ML Assignment</ButtonLabel>
          <ButtonLabel id="block-time-0" class="block-time">9:00 - 10:30</ButtonLabel>
        </Button>

        <Button id="block-1" class="schedule-block" style="background-color: #D97706; width: 120px; margin-left: 20px;">
          <ButtonLabel id="block-title-1" class="block-title">Implement API</ButtonLabel>
          <ButtonLabel id="block-time-1" class="block-time">11:00 - 1:00</ButtonLabel>
        </Button>

        <Button id="block-2" class="schedule-block" style="background-color: #7C3AED; width: 68px; margin-left: 40px;">
          <ButtonLabel id="block-title-2" class="block-title">Team Meet</ButtonLabel>
          <ButtonLabel id="block-time-2" class="block-time">2:00 - 2:30</ButtonLabel>
        </Button>

        <Button id="block-3" class="schedule-block" style="background-color: #0284C7; width: 85px; margin-left: 35px;">
          <ButtonLabel id="block-title-3" class="block-title">Research</ButtonLabel>
          <ButtonLabel id="block-time-3" class="block-time">3:30 - 5:00</ButtonLabel>
        </Button>

        <Button id="block-4" class="schedule-block" style="background-color: #16A34A; width: 75px; margin-left: 45px;">
          <ButtonLabel id="block-title-4" class="block-title">Gym</ButtonLabel>
          <ButtonLabel id="block-time-4" class="block-time">6:00 - 7:00</ButtonLabel>
        </Button>
      </div>
    </div>
  </div>

  <div class="bottom-cards-row">
    <div class="card-base" id="card-tasks">
      <div class="card-header-row">
        <div class="card-title-group">
          <span id="hub-tasks-count" class="card-title">Tasks (4)</span>
          <Button id="btn-zoom-tasks" class="card-zoom-btn">
            <ButtonLabel class="card-zoom-text">⛶ Zoom</ButtonLabel>
          </Button>
        </div>
        <div class="filter-chips-row">
          <Button id="chip-filter-all" class="filter-chip filter-chip-active">
            <ButtonLabel class="filter-chip-text-active">All</ButtonLabel>
          </Button>
          <Button id="chip-filter-high" class="filter-chip">
            <ButtonLabel class="filter-chip-text">High</ButtonLabel>
          </Button>
          <Button id="chip-filter-med" class="filter-chip">
            <ButtonLabel class="filter-chip-text">Med</ButtonLabel>
          </Button>
          <Button id="chip-filter-low" class="filter-chip">
            <ButtonLabel class="filter-chip-text">Low</ButtonLabel>
          </Button>
        </div>
      </div>

      <div class="hub-task-rows">
        <div class="hub-task-item">
          <Button id="hub-chk-box-0" class="chk-square">
            <ButtonLabel id="hub-chk-mark-0" class="chk-square-mark"></ButtonLabel>
          </Button>
          <div class="hub-task-left">
            <ButtonLabel id="hub-task-title-0" class="hub-task-text">Finish ML assignment</ButtonLabel>
          </div>
          <div class="hub-task-right">
            <span class="hub-task-badge badge-high">High 1h 30m</span>
            <Button id="hub-task-edit-0" class="task-edit-btn">
              <ButtonLabel class="task-edit-icon">✏️</ButtonLabel>
            </Button>
          </div>
        </div>

        <div class="hub-task-item">
          <Button id="hub-chk-box-1" class="chk-square">
            <ButtonLabel id="hub-chk-mark-1" class="chk-square-mark"></ButtonLabel>
          </Button>
          <div class="hub-task-left">
            <ButtonLabel id="hub-task-title-1" class="hub-task-text">Implement API</ButtonLabel>
          </div>
          <div class="hub-task-right">
            <span class="hub-task-badge badge-med">Med 2h</span>
            <Button id="hub-task-edit-1" class="task-edit-btn">
              <ButtonLabel class="task-edit-icon">✏️</ButtonLabel>
            </Button>
          </div>
        </div>

        <div class="hub-task-item">
          <Button id="hub-chk-box-2" class="chk-square">
            <ButtonLabel id="hub-chk-mark-2" class="chk-square-mark"></ButtonLabel>
          </Button>
          <div class="hub-task-left">
            <ButtonLabel id="hub-task-title-2" class="hub-task-text">Team meeting</ButtonLabel>
          </div>
          <div class="hub-task-right">
            <span class="hub-task-badge badge-low">Low 30m</span>
            <Button id="hub-task-edit-2" class="task-edit-btn">
              <ButtonLabel class="task-edit-icon">✏️</ButtonLabel>
            </Button>
          </div>
        </div>

        <div class="hub-task-item">
          <Button id="hub-chk-box-3" class="chk-square chk-square-checked">
            <ButtonLabel id="hub-chk-mark-3" class="chk-square-mark">✓</ButtonLabel>
          </Button>
          <div class="hub-task-left">
            <ButtonLabel id="hub-task-title-3" class="hub-task-text-strike">Read research paper</ButtonLabel>
          </div>
          <div class="hub-task-right">
            <span class="hub-task-badge badge-med">Med 1h</span>
            <Button id="hub-task-edit-3" class="task-edit-btn">
              <ButtonLabel class="task-edit-icon">✏️</ButtonLabel>
            </Button>
          </div>
        </div>
      </div>

      <Button id="hub-btn-add-task" class="add-task-footer-btn">
        <ButtonLabel class="add-task-footer-text">+ Add Task</ButtonLabel>
      </Button>
    </div>

    <div class="card-base" id="card-focus">
      <div class="card-header-row">
        <div class="card-title-group">
          <span class="card-title">Focus Session</span>
          <Button id="btn-zoom-focus" class="card-zoom-btn">
            <ButtonLabel class="card-zoom-text">⛶ Zoom</ButtonLabel>
          </Button>
        </div>
        <Button id="btn-focus-settings" class="card-zoom-btn">
          <ButtonLabel class="card-zoom-text">⚙️ Mode</ButtonLabel>
        </Button>
      </div>

      <div class="focus-timer-body">
        <div class="timer-ring-row">
          <div class="timer-ring">
            <span id="hub-focus-time" class="timer-digits">25:00</span>
            <span id="hub-focus-mode" class="timer-label">Pomodoro</span>
          </div>

          <Button id="hub-focus-play-btn" class="hub-play-btn">
            <ButtonLabel id="hub-focus-play-icon" class="hub-play-icon">▶</ButtonLabel>
          </Button>
        </div>

        <div class="focus-quick-chips-row">
          <Button id="hub-focus-minus5" class="focus-quick-chip">
            <ButtonLabel class="focus-quick-chip-text">-5m</ButtonLabel>
          </Button>
          <Button id="hub-focus-plus5" class="focus-quick-chip">
            <ButtonLabel class="focus-quick-chip-text">+5m</ButtonLabel>
          </Button>
          <Button id="hub-focus-reset" class="focus-quick-chip">
            <ButtonLabel class="focus-quick-chip-text">Reset</ButtonLabel>
          </Button>
          <Button id="hub-focus-break" class="focus-quick-chip">
            <ButtonLabel class="focus-quick-chip-text">Break</ButtonLabel>
          </Button>
        </div>
      </div>

      <span id="hub-focus-sessions-count" class="focus-footer-text">⏱ 4/8 Sessions Today</span>
    </div>

    <div class="card-base" id="card-workload">
      <div class="card-header-row">
        <div class="card-title-group">
          <span class="card-title">Workload</span>
          <Button id="btn-zoom-workload" class="card-zoom-btn">
            <ButtonLabel class="card-zoom-text">⛶ Zoom</ButtonLabel>
          </Button>
        </div>
      </div>

      <div class="workload-body">
        <Button id="btn-gauge-toggle" class="donut-gauge">
          <ButtonLabel id="donut-percentage-text" class="donut-gauge-text">72%</ButtonLabel>
        </Button>

        <div class="workload-legend">
          <div class="legend-row">
            <div class="legend-dot-cyan"></div>
            <span id="legend-planned-text" class="legend-text">Planned 7h 30m</span>
          </div>
          <div class="legend-row">
            <div class="legend-dot-green"></div>
            <span id="legend-completed-text" class="legend-text">Completed 2h 00m</span>
          </div>
          <div class="legend-row">
            <div class="legend-dot-gray"></div>
            <span id="legend-remaining-text" class="legend-text">Remaining 5h 30m</span>
          </div>
        </div>
      </div>

      <Button id="btn-workload-insight" class="workload-insight-capsule">
        <ButtonLabel id="workload-insight-text" class="workload-insight-text">💡 You're on track! ~2h free after 7 PM.</ButtonLabel>
      </Button>
    </div>
  </div>

  <div class="dock-container">
    <Button id="dock-timeline" class="dock-btn">
