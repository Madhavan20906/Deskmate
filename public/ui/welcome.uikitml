<!--
  Panel, Button, ButtonIcon, and ButtonLabel come from the bundled Horizon kit.
  RectangleGoggles and LogIn are bundled Lucide icon components. The :dark
  styles apply because iwsdk.config.json prefers the dark color scheme.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 480px;
  }

  .panel-content {
    flex-direction: column;
    gap: 8px;
    padding: 24px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.4px;
  }

  .eyebrow:dark {
    color: #f5d90a;
  }

  .heading {
    color: #1c1d20;
    font-size: 28px;
    font-weight: 700;
    line-height: 34px;
  }

  .heading:dark {
    color: #fafaf7;
  }

  .body {
    color: #3a3b40;
    font-size: 16px;
    line-height: 22px;
  }

  .body:dark {
    color: #dddfe3;
  }

  .onboarding-list {
    flex-direction: column;
    gap: 6px;
    margin-top: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 12px;
    background-color: #15222b;
    border-width: 1px;
    border-color: #2a3e4e;
  }

  .onboarding-step {
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 600;
  }

  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 20px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="eyebrow">DESKMATE / META QUEST XR 2026</div>
    <div class="heading">Plan with your hands on your real desk.</div>
    <div class="body">Seated hands-first mixed reality productivity. Focus beside an AI companion or body-doubling friend, and watch your habit garden bloom.</div>
    <div class="onboarding-list">
      <span class="onboarding-step">1. Enter Mixed Reality & pinch your first task card</span>
      <span class="onboarding-step">2. Place cards on Morning, Afternoon & Evening ruler</span>
      <span class="onboarding-step">3. Overloaded slots wobble & alert you to balance work</span>
      <span class="onboarding-step">4. Pip AI converts spoken thoughts into task cards</span>
      <span class="onboarding-step">5. Drop finished cards into the glass jar to bloom your garden</span>
    </div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter Mixed Reality</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
