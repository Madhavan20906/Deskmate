<Panel class="glass-focus-panel" id="glass-focus-root">
  <style>
    .glass-focus-panel {
      flex-direction: column;
      width: 340px;
      height: 330px;
      padding: 16px;
      border-radius: 24px;
      background-color: rgba(11, 16, 32, 0.78);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.16);
      gap: 12px;
      align-items: center;
    }

    .panel-handle {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 10px;
      margin-bottom: 2px;
    }

    .handle-bar {
      width: 48px;
      height: 4px;
      border-radius: 999px;
      background-color: rgba(255, 255, 255, 0.28);
    }

    .focus-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }

    .focus-title {
      font-size: 18px;
      font-weight: 700;
      color: #FFFFFF;
    }

    .focus-mode-badge {
      padding-left: 8px;
      padding-right: 8px;
      padding-top: 3px;
      padding-bottom: 3px;
      border-radius: 999px;
      background-color: rgba(124, 92, 255, 0.20);
      border-width: 1px;
      border-color: rgba(124, 92, 255, 0.50);
    }

    .focus-mode-text {
      font-size: 11px;
      font-weight: 700;
      color: #A78BFA;
    }

    .focus-ring-container {
      width: 130px;
      height: 130px;
      border-radius: 999px;
      border-width: 6px;
      border-color: #7C5CFF;
      background-color: rgba(124, 92, 255, 0.10);
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 2px;
    }

    .focus-time-display {
      font-size: 30px;
      font-weight: 800;
      color: #FFFFFF;
      line-height: 32px;
    }

    .focus-sublabel {
      font-size: 11px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.65);
    }

    .focus-controls-row {
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }

    .play-pause-btn {
      width: 52px;
      height: 52px;
      border-radius: 999px;
      background-color: #7C5CFF;
      align-items: center;
      justify-content: center;
    }

    .play-pause-icon {
      font-size: 20px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .focus-chips-row {
      flex-direction: row;
      gap: 8px;
      width: 100%;
      justify-content: center;
    }

    .focus-chip {
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 5px;
      padding-bottom: 5px;
      border-radius: 999px;
      background-color: rgba(255, 255, 255, 0.08);
      border-width: 1px;
      border-color: rgba(255, 255, 255, 0.15);
      align-items: center;
      justify-content: center;
    }

    .focus-chip-text {
      font-size: 12px;
      font-weight: 600;
      color: #E2E8F0;
    }
  </style>

  <div class="panel-handle">
    <div class="handle-bar"></div>
  </div>

  <div class="focus-header">
    <span class="focus-title">Focus</span>
    <div class="focus-mode-badge">
      <span id="focus-mode-label" class="focus-mode-text">Pomodoro</span>
    </div>
  </div>

  <div class="focus-ring-container">
    <span id="focus-countdown" class="focus-time-display">25:00</span>
    <span class="focus-sublabel">Sprint 1 of 4</span>
  </div>

  <div class="focus-controls-row">
    <Button id="btn-focus-play-pause" class="play-pause-btn">
      <ButtonLabel id="focus-play-label" class="play-pause-icon">&gt;</ButtonLabel>
    </Button>
  </div>

  <div class="focus-chips-row">
    <Button id="chip-focus-minus5" class="focus-chip">
      <ButtonLabel class="focus-chip-text">-5m</ButtonLabel>
    </Button>
    <Button id="chip-focus-plus5" class="focus-chip">
      <ButtonLabel class="focus-chip-text">+5m</ButtonLabel>
    </Button>
    <Button id="chip-focus-reset" class="focus-chip">
      <ButtonLabel class="focus-chip-text">Reset</ButtonLabel>
    </Button>
    <Button id="chip-focus-break" class="focus-chip">
      <ButtonLabel class="focus-chip-text">Break</ButtonLabel>
    </Button>
  </div>
</Panel>
