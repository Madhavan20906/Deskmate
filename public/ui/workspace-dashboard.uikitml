<style>
  .dashboard {
    flex-direction: column;
    width: 900px;
    border-radius: 24px;
    border-width: 1px;
    border-color: #3b5664;
    background-color: #111a22;
  }

  .content {
    flex-direction: column;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .topline {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .header-actions {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .xr-button {
    background-color: #0082fb;
  }

  .workspace-setup {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: #203039;
  }

  .workspace-anchor-status {
    color: #8ce2d2;
    font-size: 13px;
    font-weight: 700;
  }

  .workspace-setup-actions {
    flex-direction: row;
    gap: 8px;
  }

  .pip-toggle {
    flex-direction: row;
    align-items: center;
    gap: 7px;
  }

  .pip-launcher-orb {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: #53cbb5;
  }

  .pip-panel {
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 14px;
    border-width: 1px;
    border-color: #6faeaa;
    background-color: #e8f4f4;
  }

  .pip-panel:dark {
    background-color: #182b33;
    border-color: #3b6970;
  }

  .pip-heading {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .pip-orb {
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: #53cbb5;
  }

  .pip-face {
    flex-direction: row;
    align-items: center;
    gap: 5px;
  }

  .pip-eye {
    width: 4px;
    height: 7px;
    border-radius: 3px;
    background-color: #143139;
  }

  .pip-heading-copy {
    flex-direction: column;
    flex-grow: 1;
    gap: 2px;
  }

  .pip-name {
    color: #173740;
    font-size: 16px;
    font-weight: 700;
  }

  .pip-name:dark {
    color: #f3f6f7;
  }

  .pip-state {
    color: #285d5d;
    font-size: 11px;
    font-weight: 700;
  }

  .pip-state:dark {
    color: #8ce2d2;
  }

  .pip-response {
    color: #173740;
    font-size: 14px;
    font-weight: 600;
  }

  .pip-response:dark {
    color: #e8eef0;
  }

  .pip-transcript {
    color: #31555d;
    font-size: 12px;
  }

  .pip-transcript:dark {
    color: #b6c7ce;
  }

  .pip-disclosure {
    color: #465e65;
    font-size: 11px;
  }

  .pip-disclosure:dark {
    color: #9eb4bf;
  }

  .pip-controls {
    flex-direction: row;
    gap: 8px;
  }

  .pip-control-button {
    flex-grow: 1;
  }

  .pip-confirmation-row {
    flex-direction: row;
    gap: 8px;
  }

  .pip-confirm-button {
    flex-grow: 1;
  }

  .brand {
    color: #f3f6f7;
    font-size: 30px;
    font-weight: 700;
  }

  .date {
    color: #9eb4bf;
    font-size: 16px;
    font-weight: 600;
  }

  .day-chip {
    align-items: center;
    justify-content: center;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 16px;
    background-color: #183942;
  }

  .day-chip-text {
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 700;
  }

  .workload {
    flex-direction: column;
    gap: 9px;
    padding-top: 13px;
    padding-bottom: 13px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 14px;
    background-color: #18242d;
  }

  .workload-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .workload-title {
    color: #dce7eb;
    font-size: 17px;
    font-weight: 700;
  }

  .workload-value {
    color: #8ce2d2;
    font-size: 16px;
    font-weight: 700;
  }

  .workload-state {
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    border-radius: 10px;
    background-color: #e4f0f3;
    color: #1c252a;
    font-size: 12px;
    font-weight: 700;
  }

  .workload-state:dark {
    background-color: #183942;
    color: #8ce2d2;
  }

  .workload-detail {
    color: #3a4b53;
    font-size: 13px;
    font-weight: 600;
  }

  .workload-detail:dark {
    color: #b6c7ce;
  }

  .load-track {
    flex-direction: row;
    gap: 8px;
  }

  .load-segment {
    width: 96px;
    height: 9px;
    border-radius: 5px;
    background-color: #34434c;
  }

  .load-filled {
    background-color: #53cbb5;
  }

  .timeline-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .timeline-title {
    color: #f3f6f7;
    font-size: 19px;
    font-weight: 700;
  }

  .timeline-note {
    color: #9eb4bf;
    font-size: 14px;
  }

  .time-markers {
    flex-direction: row;
    justify-content: space-between;
  }

  .time-marker {
    color: #9eb4bf;
    font-size: 12px;
    font-weight: 700;
  }

  .timeline {
    flex-direction: row;
    gap: 8px;
  }

  .time-slot {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 7px;
    width: 158px;
    height: 104px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 9px;
    padding-right: 9px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #2b414c;
    background-color: #15212a;
  }

  .slot-time {
    color: #8ce2d2;
    font-size: 13px;
    font-weight: 700;
  }

  .slot-content {
    color: #e8eef0;
    font-size: 12px;
    font-weight: 600;
  }

  .smart-status-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .schedule-status {
    color: #dce7eb;
    font-size: 13px;
    font-weight: 600;
  }

  .smart-status {
    color: #8ce2d2;
    font-size: 13px;
    font-weight: 700;
  }

  .schedule-suggestion {
    color: #f2bf7b;
    font-size: 13px;
    font-weight: 700;
  }

  .schedule-controls {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .schedule-button {
    flex-grow: 1;
  }

  .selection-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: #203039;
  }

  .selection-label {
    color: #9eb4bf;
    font-size: 14px;
  }

  .selection-value {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
  }

  .focus-duration-controls {
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }

  .focus-duration-value {
    color: #174b4b;
    font-size: 13px;
    font-weight: 700;
  }

  .focus-duration-value:dark {
    color: #8ce2d2;
  }

  .focus-duration-button {
    width: 42px;
  }

  .focus-stats {
    flex-direction: column;
    gap: 6px;
  }

  .focus-statistics {
    color: #35525a;
    font-size: 12px;
    font-weight: 700;
  }

  .focus-statistics:dark {
    color: #b6c7ce;
  }

  .focus-history {
    color: #9eb4bf;
    font-size: 10px;
  }

  .focus-progress {
    flex-direction: row;
    gap: 6px;
  }

  .focus-progress-segment {
    width: 100px;
    height: 6px;
    border-radius: 3px;
    background-color: #34434c;
  }

  .insights-row {
    flex-direction: row;
    align-items: stretch;
    gap: 12px;
  }

  .insight-card {
    flex-direction: column;
    flex-grow: 1;
    gap: 8px;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 13px;
    padding-right: 13px;
    border-radius: 12px;
    background-color: #18242d;
  }

  .insight-heading {
    color: #dce7eb;
    font-size: 13px;
    font-weight: 700;
  }

  .garden-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .garden-plant {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    width: 52px;
    height: 62px;
    border-radius: 12px;
    background-color: #203039;
  }

  .garden-leaves {
    flex-direction: row;
    align-items: center;
    gap: 2px;
  }

  .garden-crown {
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .garden-leaf {
    width: 12px;
    height: 8px;
    border-radius: 6px;
    background-color: #53cbb5;
  }

  .garden-flower {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #f2bf7b;
  }

  .garden-stem {
    width: 4px;
    height: 18px;
    border-radius: 2px;
    background-color: #53cbb5;
  }

  .garden-soil {
    width: 24px;
    height: 4px;
    border-radius: 2px;
    background-color: #9a7652;
  }

  .garden-copy {
    flex-direction: column;
    flex-grow: 1;
    gap: 3px;
  }

  .garden-details {
    color: #b6c7ce;
    font-size: 11px;
    font-weight: 600;
  }

  .garden-achievements {
    color: #b6c7ce;
    font-size: 11px;
    font-weight: 600;
  }

  .analytics-summary {
    color: #b6c7ce;
    font-size: 11px;
    font-weight: 600;
  }

  .garden-stage {
    color: #8ce2d2;
    font-size: 13px;
    font-weight: 700;
  }

  .garden-progress {
    flex-direction: row;
    align-items: center;
    gap: 5px;
  }

  .analytics-bars {
    flex-direction: row;
    align-items: center;
    gap: 5px;
  }

  .garden-progress-segment {
    flex-grow: 1;
    height: 6px;
    border-radius: 3px;
    background-color: #34434c;
  }

  .analytics-bars {
    justify-content: space-between;
    gap: 7px;
  }

  .analytics-day {
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .analytics-bar {
    width: 26px;
    height: 30px;
    border-radius: 6px;
    background-color: #34434c;
  }

  .analytics-day-label {
    color: #9eb4bf;
    font-size: 9px;
    font-weight: 700;
  }

  .analytics-day-count {
    color: #9eb4bf;
    font-size: 9px;
    font-weight: 700;
  }

  .task-actions {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .task-summary {
    color: #9eb4bf;
    font-size: 14px;
  }

  .create-button {
    margin-top: 2px;
  }

  .ghost-audio-button {
    background-color: #182b33;
    border-color: #3b5664;
  }

  .pip-emote {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 6px;
    background-color: #203039;
    color: #8ce2d2;
    font-size: 10px;
    font-weight: 700;
  }

  .break-banner {
    flex-direction: column;
    gap: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 12px;
    background-color: #172d34;
    border-width: 1px;
    border-color: #53cbb5;
  }

  .break-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .break-title {
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 700;
  }

  .break-timer {
    color: #f2bf7b;
    font-size: 15px;
    font-weight: 700;
  }

  .break-suggestion {
    color: #e8eef0;
    font-size: 13px;
    font-weight: 600;
  }

  .break-actions {
    flex-direction: row;
    gap: 8px;
  }

  .break-btn {
    flex-grow: 1;
  }

  .timeline-zones {
    flex-direction: row;
    gap: 8px;
  }

  .timeline-zone {
    flex-grow: 1;
    border-width: 1px;
    border-color: #2b414c;
    background-color: #182833;
  }

  .welcome-back-bar {
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: #182b33;
    border-width: 1px;
    border-color: #3b5664;
  }

  .welcome-back-line {
    color: #8ce2d2;
    font-size: 13px;
    font-weight: 700;
  }

  .jar-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .jar-badge {
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 8px;
    background-color: #183942;
    color: #8ce2d2;
    font-size: 11px;
    font-weight: 700;
  }

  .jar-status {
    color: #b6c7ce;
    font-size: 11px;
    font-weight: 600;
  }

  .jar-week-display {
    flex-direction: row;
    justify-content: space-between;
    gap: 6px;
  }

  .jar-day-col {
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .jar-day-label {
    color: #9eb4bf;
    font-size: 9px;
    font-weight: 700;
  }

  .jar-box {
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #34434c;
    background-color: #203039;
  }

  .jar-token-count {
    color: #f2bf7b;
    font-size: 11px;
    font-weight: 700;
  }

  .analytics-toggle-bar {
    flex-direction: row;
    justify-content: center;
    margin-top: 4px;
    margin-bottom: 2px;
  }

  .analytics-toggle-button {
    background-color: #1a2a34;
    border-color: #3b5664;
    border-width: 1px;
    border-radius: 999px;
  }

  .analytics-drawer {
    flex-direction: column;
    gap: 12px;
  }
</style>
<Panel class="dashboard">
  <div class="content">
    <div class="topline">
      <div>
        <div class="brand">DESKMATE</div>
        <div id="day-date" class="date">TODAY</div>
      </div>
      <div class="header-actions">
        <div class="day-chip"><span class="day-chip-text">YOUR DAY</span></div>
        <Button id="ghost-audio-toggle" class="ghost-audio-button">
          <ButtonLabel id="ghost-audio-label">Deskmate: Sound on</ButtonLabel>
        </Button>
        <Button id="xr-button" class="xr-button">
          <ButtonLabel>Enter XR</ButtonLabel>
        </Button>
        <Button id="exit-button" class="xr-button" style="display: none">
          <ButtonLabel>Exit XR</ButtonLabel>
        </Button>
        <Button id="pip-toggle" class="pip-toggle">
          <span id="pip-launcher-orb" class="pip-launcher-orb"></span>
          <ButtonLabel>PIP</ButtonLabel>
        </Button>
      </div>
    </div>
    <div class="workspace-setup">
      <span id="workspace-anchor-status" class="workspace-anchor-status">Workspace ready. Enter XR, look at a tabletop, then pin your desk.</span>
      <div class="workspace-setup-actions">
        <Button id="workspace-pin">
          <ButtonLabel>Pin to desk</ButtonLabel>
        </Button>
        <Button id="workspace-reset">
          <ButtonLabel>Reset</ButtonLabel>
        </Button>
      </div>
    </div>
    <div id="pip-panel" class="pip-panel" style="display: none">
      <div class="pip-heading">
        <div id="pip-orb" class="pip-orb">
          <div class="pip-face">
            <span class="pip-eye"></span>
            <span class="pip-eye"></span>
          </div>
        </div>
        <div class="pip-heading-copy">
          <span class="pip-name">PIP / LOCAL COMMAND MODE</span>
          <span id="pip-state" class="pip-state">READY / LOCAL MODE</span>
        </div>
        <span id="pip-emote-badge" class="pip-emote">GREETING</span>
        <Button id="pip-dismiss">
          <ButtonLabel>Hide</ButtonLabel>
        </Button>
      </div>
      <span id="pip-response" class="pip-response">Ask Pip to add a task, review today's plan, or create a schedule suggestion.</span>
      <span id="pip-transcript" class="pip-transcript">No request yet.</span>
      <span class="pip-disclosure">No AI provider is connected. Tap Listen only when ready; your browser may use its speech service to transcribe audio. Pip parses requests locally and sends no task data to an AI service.</span>
      <div class="pip-controls">
        <Button id="pip-listen" class="pip-control-button">
          <ButtonLabel id="pip-listen-label">Listen</ButtonLabel>
        </Button>
        <Button id="pip-text" class="pip-control-button">
          <ButtonLabel>Type request</ButtonLabel>
        </Button>
        <Button id="pip-recap" class="pip-control-button">
          <ButtonLabel>Daily recap</ButtonLabel>
        </Button>
        <Button id="pip-morning-ritual" class="pip-control-button">
          <ButtonLabel>Morning ritual</ButtonLabel>
        </Button>
        <Button id="pip-evening-ritual" class="pip-control-button">
          <ButtonLabel>Evening wind-down</ButtonLabel>
        </Button>
      </div>
      <div id="pip-confirmation-row" class="pip-confirmation-row" style="display: none">
        <Button id="pip-confirm-schedule" class="pip-confirm-button">
          <ButtonLabel>Confirm schedule</ButtonLabel>
        </Button>
        <Button id="pip-cancel-schedule" class="pip-confirm-button">
          <ButtonLabel>Cancel</ButtonLabel>
        </Button>
      </div>
      <div id="pip-ritual-actions" class="pip-confirmation-row" style="display: none">
        <Button id="pip-ritual-next" class="pip-confirm-button">
          <ButtonLabel id="pip-ritual-next-label">Next step</ButtonLabel>
        </Button>
        <Button id="pip-ritual-finish" class="pip-confirm-button">
          <ButtonLabel>Finish ritual</ButtonLabel>
        </Button>
      </div>
    </div>
    <div id="break-banner" class="break-banner" style="display: none">
      <div class="break-header">
        <span class="break-title">SEATED BREAK MODE</span>
        <span id="break-timer" class="break-timer">60s remaining</span>
      </div>
      <span id="break-suggestion" class="break-suggestion">Pip suggests: Roll your shoulders back and take a deep breath. The jar fills when your break is complete!</span>
      <div class="break-actions">
        <Button id="break-complete-btn" class="break-btn">
          <ButtonLabel>Finish break &amp; fill jar</ButtonLabel>
        </Button>
        <Button id="break-skip-btn" class="break-btn">
          <ButtonLabel>Skip break</ButtonLabel>
        </Button>
      </div>
    </div>
    <div class="workload">
      <div class="workload-heading">
        <span class="workload-title">DAILY WORKLOAD</span>
        <span id="workload-value" class="workload-value">0h planned / 8h capacity</span>
      </div>
      <div class="load-track">
        <div id="load-segment-1" class="load-segment"></div>
        <div id="load-segment-2" class="load-segment"></div>
        <div id="load-segment-3" class="load-segment"></div>
        <div id="load-segment-4" class="load-segment"></div>
        <div id="load-segment-5" class="load-segment"></div>
        <div id="load-segment-6" class="load-segment"></div>
        <div id="load-segment-7" class="load-segment"></div>
        <div id="load-segment-8" class="load-segment"></div>
      </div>
      <div class="smart-status-row">
        <span id="workload-state" class="workload-state">UNDERLOADED</span>
        <span id="workload-detail" class="workload-detail">8h free / 0m complete / 0m pending</span>
      </div>
    </div>
    <div class="timeline-heading">
      <span class="timeline-title">TODAY'S TIMELINE</span>
      <span class="timeline-note">WORKING HOURS / 08:00 - 18:00</span>
    </div>
    <div class="timeline-zones">
      <Button id="timeline-zone-morning" class="timeline-zone">
        <ButtonLabel id="timeline-zone-morning-label">Morning (08:00 - 11:30)</ButtonLabel>
      </Button>
      <Button id="timeline-zone-midday" class="timeline-zone">
        <ButtonLabel id="timeline-zone-midday-label">Midday (11:30 - 14:30)</ButtonLabel>
      </Button>
      <Button id="timeline-zone-evening" class="timeline-zone">
        <ButtonLabel id="timeline-zone-evening-label">Evening (14:30 - 18:00)</ButtonLabel>
      </Button>
    </div>
    <div class="time-markers">
      <span class="time-marker">08:00</span>
      <span class="time-marker">10:00</span>
      <span class="time-marker">12:00</span>
      <span class="time-marker">14:00</span>
      <span class="time-marker">16:00</span>
      <span class="time-marker">18:00</span>
    </div>
    <div class="timeline">
      <Button id="timeline-slot-480" class="time-slot">
        <ButtonLabel id="timeline-slot-label-480" class="slot-time">08:00 - 10:00</ButtonLabel>
        <span id="timeline-slot-content-480" class="slot-content">No tasks scheduled</span>
      </Button>
      <Button id="timeline-slot-600" class="time-slot">
        <ButtonLabel id="timeline-slot-label-600" class="slot-time">10:00 - 12:00</ButtonLabel>
        <span id="timeline-slot-content-600" class="slot-content">No tasks scheduled</span>
      </Button>
      <Button id="timeline-slot-720" class="time-slot">
        <ButtonLabel id="timeline-slot-label-720" class="slot-time">12:00 - 14:00</ButtonLabel>
        <span id="timeline-slot-content-720" class="slot-content">No tasks scheduled</span>
      </Button>
      <Button id="timeline-slot-840" class="time-slot">
        <ButtonLabel id="timeline-slot-label-840" class="slot-time">14:00 - 16:00</ButtonLabel>
        <span id="timeline-slot-content-840" class="slot-content">No tasks scheduled</span>
      </Button>
      <Button id="timeline-slot-960" class="time-slot">
        <ButtonLabel id="timeline-slot-label-960" class="slot-time">16:00 - 18:00</ButtonLabel>
        <span id="timeline-slot-content-960" class="slot-content">No tasks scheduled</span>
      </Button>
    </div>
    <span id="schedule-status" class="schedule-status">Select a task, then pick a timeline block.</span>
    <div class="smart-status-row">
      <span id="smart-status" class="smart-status">Checking today's plan...</span>
      <span id="schedule-suggestion" class="schedule-suggestion">Select a task for a slot suggestion</span>
    </div>
    <div class="schedule-controls">
      <Button id="schedule-earlier" class="schedule-button">
        <ButtonLabel>Earlier 30m</ButtonLabel>
      </Button>
      <Button id="schedule-later" class="schedule-button">
        <ButtonLabel>Later 30m</ButtonLabel>
      </Button>
      <Button id="schedule-apply-suggestion" class="schedule-button">
        <ButtonLabel>Apply suggestion</ButtonLabel>
      </Button>
      <Button id="schedule-dismiss-suggestion" class="schedule-button">
        <ButtonLabel>Dismiss</ButtonLabel>
      </Button>
      <Button id="schedule-clear" class="schedule-button">
        <ButtonLabel>Clear time</ButtonLabel>
      </Button>
    </div>
    <div class="selection-row">
      <span class="selection-label">SELECTED TASK</span>
      <span id="selected-task" class="selection-value">Choose a task card</span>
    </div>
    <div class="analytics-toggle-bar">
      <Button id="toggle-analytics" class="analytics-toggle-button">
        <ButtonLabel id="toggle-analytics-label">Insights &amp; History (Show)</ButtonLabel>
      </Button>
    </div>
    <div id="analytics-drawer" class="analytics-drawer" style="display: none">
      <div class="focus-stats">
        <span id="focus-statistics" class="focus-statistics">FOCUS TODAY 0m / 120m GOAL / 0 SESSIONS / TOTAL 0m</span>
        <span id="focus-history" class="focus-history">NO FOCUS HISTORY YET</span>
        <div class="focus-progress">
          <div id="focus-progress-1" class="focus-progress-segment"></div>
          <div id="focus-progress-2" class="focus-progress-segment"></div>
          <div id="focus-progress-3" class="focus-progress-segment"></div>
          <div id="focus-progress-4" class="focus-progress-segment"></div>
          <div id="focus-progress-5" class="focus-progress-segment"></div>
          <div id="focus-progress-6" class="focus-progress-segment"></div>
          <div id="focus-progress-7" class="focus-progress-segment"></div>
          <div id="focus-progress-8" class="focus-progress-segment"></div>
        </div>
      </div>
      <div class="welcome-back-bar">
        <span id="welcome-back-line" class="welcome-back-line">Welcome back! 3-day focus streak active - let's fill today's jar!</span>
      </div>
      <div class="insights-row">
        <div class="insight-card">
          <span class="insight-heading">PRODUCTIVITY GARDEN</span>
          <div class="garden-row">
            <div class="garden-plant">
              <div class="garden-crown">
                <span id="garden-flower" class="garden-flower" style="display: none"></span>
                <div id="garden-leaves-1" class="garden-leaves" style="display: none"><span class="garden-leaf"></span><span class="garden-leaf"></span></div>
                <div id="garden-leaves-2" class="garden-leaves" style="display: none"><span class="garden-leaf"></span><span class="garden-leaf"></span></div>
                <div id="garden-leaves-3" class="garden-leaves" style="display: none"><span class="garden-leaf"></span><span class="garden-leaf"></span></div>
                <div id="garden-leaves-4" class="garden-leaves" style="display: none"><span class="garden-leaf"></span><span class="garden-leaf"></span></div>
              </div>
              <div id="garden-stem" class="garden-stem"></div>
              <div class="garden-soil"></div>
            </div>
            <div class="garden-copy">
              <span id="garden-stage" class="garden-stage">SEED GARDEN</span>
              <span id="garden-details" class="garden-details">0 growth points / 0-day streak</span>
              <span id="garden-achievements" class="garden-achievements">Next: Sprout at 20 points</span>
            </div>
          </div>
          <div class="garden-progress">
            <div id="garden-progress-1" class="garden-progress-segment"></div>
            <div id="garden-progress-2" class="garden-progress-segment"></div>
            <div id="garden-progress-3" class="garden-progress-segment"></div>
            <div id="garden-progress-4" class="garden-progress-segment"></div>
          </div>
        </div>
        <div class="insight-card">
          <div class="jar-header-row">
            <span class="insight-heading">WEEKLY FOCUS JAR</span>
            <span id="today-jar-badge" class="jar-badge">0 / 4 TOKENS</span>
          </div>
          <span id="today-jar-status" class="jar-status">Today: 0 tokens in jar. Sprints &amp; breaks fill it!</span>
          <div class="jar-week-display">
            <div class="jar-day-col"><span id="jar-day-label-1" class="jar-day-label">MON</span><div id="jar-box-1" class="jar-box"><span id="jar-tokens-1" class="jar-token-count">0</span></div></div>
            <div class="jar-day-col"><span id="jar-day-label-2" class="jar-day-label">TUE</span><div id="jar-box-2" class="jar-box"><span id="jar-tokens-2" class="jar-token-count">0</span></div></div>
            <div class="jar-day-col"><span id="jar-day-label-3" class="jar-day-label">WED</span><div id="jar-box-3" class="jar-box"><span id="jar-tokens-3" class="jar-token-count">0</span></div></div>
            <div class="jar-day-col"><span id="jar-day-label-4" class="jar-day-label">THU</span><div id="jar-box-4" class="jar-box"><span id="jar-tokens-4" class="jar-token-count">0</span></div></div>
            <div class="jar-day-col"><span id="jar-day-label-5" class="jar-day-label">FRI</span><div id="jar-box-5" class="jar-box"><span id="jar-tokens-5" class="jar-token-count">0</span></div></div>
            <div class="jar-day-col"><span id="jar-day-label-6" class="jar-day-label">SAT</span><div id="jar-box-6" class="jar-box"><span id="jar-tokens-6" class="jar-token-count">0</span></div></div>
            <div class="jar-day-col"><span id="jar-day-label-7" class="jar-day-label">SUN</span><div id="jar-box-7" class="jar-box"><span id="jar-tokens-7" class="jar-token-count">0</span></div></div>
          </div>
        </div>
        <div class="insight-card">
          <span class="insight-heading">7-DAY MOMENTUM</span>
          <div class="analytics-bars">
            <div class="analytics-day"><span id="analytics-day-label-1" class="analytics-day-label">MON</span><span id="analytics-bar-1" class="analytics-bar"></span><span id="analytics-day-count-1" class="analytics-day-count">0</span></div>
            <div class="analytics-day"><span id="analytics-day-label-2" class="analytics-day-label">TUE</span><span id="analytics-bar-2" class="analytics-bar"></span><span id="analytics-day-count-2" class="analytics-day-count">0</span></div>
            <div class="analytics-day"><span id="analytics-day-label-3" class="analytics-day-label">WED</span><span id="analytics-bar-3" class="analytics-bar"></span><span id="analytics-day-count-3" class="analytics-day-count">0</span></div>
            <div class="analytics-day"><span id="analytics-day-label-4" class="analytics-day-label">THU</span><span id="analytics-bar-4" class="analytics-bar"></span><span id="analytics-day-count-4" class="analytics-day-count">0</span></div>
            <div class="analytics-day"><span id="analytics-day-label-5" class="analytics-day-label">FRI</span><span id="analytics-bar-5" class="analytics-bar"></span><span id="analytics-day-count-5" class="analytics-day-count">0</span></div>
            <div class="analytics-day"><span id="analytics-day-label-6" class="analytics-day-label">SAT</span><span id="analytics-bar-6" class="analytics-bar"></span><span id="analytics-day-count-6" class="analytics-day-count">0</span></div>
            <div class="analytics-day"><span id="analytics-day-label-7" class="analytics-day-label">SUN</span><span id="analytics-bar-7" class="analytics-bar"></span><span id="analytics-day-count-7" class="analytics-day-count">0</span></div>
          </div>
          <span id="analytics-summary" class="analytics-summary">0 tasks / 0m focus / 0% complete</span>
        </div>
      </div>
    </div>
    <div class="task-actions">
      <span id="task-summary" class="task-summary">3 / 6 tasks</span>
      <div class="focus-duration-controls">
        <Button id="focus-duration-down" class="focus-duration-button">
          <ButtonLabel>-5</ButtonLabel>
        </Button>
        <span id="focus-duration-value" class="focus-duration-value">25 MIN</span>
        <Button id="focus-duration-up" class="focus-duration-button">
          <ButtonLabel>+5</ButtonLabel>
        </Button>
      </div>
      <Button id="task-create" class="create-button">
        <ButtonLabel>Create task</ButtonLabel>
      </Button>
    </div>
  </div>
</Panel>