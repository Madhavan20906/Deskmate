<style>
  .dashboard {
    flex-direction: column;
    width: 900px;
    border-radius: 24px;
    border-width: 1px;
    border-color: #3b5664;
    background-color: #111a22;
  }

  .content {
    flex-direction: column;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .topline {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .header-actions {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .pip-toggle {
    flex-direction: row;
    align-items: center;
    gap: 7px;
  }

  .pip-launcher-orb {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: #53cbb5;
  }

  .pip-panel {
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 14px;
    border-width: 1px;
    border-color: #6faeaa;
    background-color: #e8f4f4;
  }

  .pip-panel:dark {
    background-color: #182b33;
    border-color: #3b6970;
  }

  .pip-heading {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .pip-orb {
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: #53cbb5;
  }

  .pip-face {
    flex-direction: row;
    align-items: center;
    gap: 5px;
  }

  .pip-eye {
    width: 4px;
    height: 7px;
    border-radius: 3px;
    background-color: #143139;
  }

  .pip-heading-copy {
    flex-direction: column;
    flex-grow: 1;
    gap: 2px;
  }

  .pip-name {
    color: #173740;
    font-size: 16px;
    font-weight: 700;
  }

  .pip-name:dark {
    color: #f3f6f7;
  }

  .pip-state {
    color: #285d5d;
    font-size: 14px;
    font-weight: 700;
  }

  .pip-state:dark {
    color: #8ce2d2;
  }

  .pip-response {
    color: #173740;
    font-size: 15px;
    font-weight: 600;
  }

  .pip-response:dark {
    color: #e8eef0;
  }

  .pip-transcript {
    color: #31555d;
    font-size: 14px;
  }

  .pip-transcript:dark {
    color: #b6c7ce;
  }

  .pip-disclosure {
    color: #465e65;
    font-size: 14px;
  }

  .pip-disclosure:dark {
    color: #9eb4bf;
  }

  .pip-controls {
    flex-direction: row;
    gap: 8px;
  }

  .pip-control-button {
    flex-grow: 1;
  }

  .pip-confirmation-row {
    flex-direction: row;
    gap: 8px;
  }

  .pip-confirm-button {
    flex-grow: 1;
  }

  .brand {
    color: #f3f6f7;
    font-size: 30px;
    font-weight: 700;
  }

  .date {
    color: #9eb4bf;
    font-size: 16px;
    font-weight: 600;
  }

  .day-chip {
    align-items: center;
    justify-content: center;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 16px;
    background-color: #183942;
  }

  .day-chip-text {
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 700;
  }

  .workload {
    flex-direction: column;
    gap: 9px;
    padding-top: 13px;
    padding-bottom: 13px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 14px;
    background-color: #18242d;
  }

  .workload-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .workload-title {
    color: #dce7eb;
    font-size: 17px;
    font-weight: 700;
  }

  .workload-value {
    color: #8ce2d2;
    font-size: 16px;
    font-weight: 700;
  }

  .workload-state {
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    border-radius: 10px;
    background-color: #e4f0f3;
    color: #1c252a;
    font-size: 14px;
    font-weight: 700;
  }

  .workload-state:dark {
    background-color: #183942;
    color: #8ce2d2;
  }

  .workload-detail {
    color: #3a4b53;
    font-size: 14px;
    font-weight: 600;
  }

  .workload-detail:dark {
    color: #b6c7ce;
  }

  .load-track {
    flex-direction: row;
    gap: 8px;
  }

  .load-segment {
    width: 96px;
    height: 9px;
    border-radius: 5px;
    background-color: #34434c;
  }

  .load-filled {
    background-color: #53cbb5;
  }

  .timeline-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .timeline-title {
    color: #f3f6f7;
    font-size: 19px;
    font-weight: 700;
  }

  .timeline-note {
    color: #9eb4bf;
    font-size: 14px;
  }

  .time-markers {
    flex-direction: row;
    justify-content: space-between;
  }

  .time-marker {
    color: #9eb4bf;
    font-size: 14px;
    font-weight: 700;
  }

  .timeline {
    flex-direction: row;
    gap: 8px;
  }

  .time-slot {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 7px;
    width: 158px;
    height: 104px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 9px;
    padding-right: 9px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #2b414c;
    background-color: #15212a;
  }

  .slot-time {
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 700;
  }

  .slot-content {
    color: #e8eef0;
    font-size: 14px;
    font-weight: 600;
  }

  .smart-status-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .schedule-status {
    color: #dce7eb;
    font-size: 14px;
    font-weight: 600;
  }

  .smart-status {
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 700;
  }

  .schedule-suggestion {
    color: #f2bf7b;
    font-size: 14px;
    font-weight: 700;
  }

  .schedule-controls {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .schedule-button {
    flex-grow: 1;
  }

  .selection-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    background-color: #203039;
  }

  .selection-label {
    color: #9eb4bf;
    font-size: 14px;
  }

  .selection-value {
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
  }

  .focus-duration-controls {
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }

  .focus-duration-value {
    color: #174b4b;
    font-size: 14px;
    font-weight: 700;
  }

  .focus-duration-value:dark {
    color: #8ce2d2;
  }

  .focus-duration-button {
    width: 42px;
  }

  .focus-stats {
    flex-direction: column;
    gap: 6px;
  }

  .focus-statistics {
    color: #35525a;
    font-size: 14px;
    font-weight: 700;
  }

  .focus-statistics:dark {
    color: #b6c7ce;
  }

  .focus-history {
    color: #9eb4bf;
    font-size: 14px;
  }

  .focus-progress {
    flex-direction: row;
    gap: 6px;
  }

  .focus-progress-segment {
    width: 100px;
    height: 6px;
    border-radius: 3px;
    background-color: #34434c;
  }

  .insights-row {
    flex-direction: row;
    align-items: stretch;
    gap: 12px;
  }

  .insight-card {
    flex-direction: column;
    flex-grow: 1;
    gap: 8px;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 13px;
    padding-right: 13px;
    border-radius: 12px;
    background-color: #18242d;
  }

  .insight-heading {
    color: #dce7eb;
    font-size: 14px;
    font-weight: 700;
  }

  .garden-row {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .garden-plant {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    width: 52px;
    height: 62px;
    border-radius: 12px;
    background-color: #203039;
  }

  .garden-leaves {
    flex-direction: row;
    align-items: center;
    gap: 2px;
  }

  .garden-crown {
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .garden-leaf {
    width: 12px;
    height: 8px;
    border-radius: 6px;
    background-color: #53cbb5;
  }

  .garden-flower {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #f2bf7b;
  }

  .garden-stem {
    width: 4px;
    height: 18px;
    border-radius: 2px;
    background-color: #53cbb5;
  }

  .garden-soil {
    width: 24px;
    height: 4px;
    border-radius: 2px;
    background-color: #9a7652;
  }

  .garden-copy {
    flex-direction: column;
    flex-grow: 1;
    gap: 3px;
  }

  .garden-details {
    color: #b6c7ce;
    font-size: 14px;
    font-weight: 600;
  }

  .garden-achievements {
    color: #b6c7ce;
    font-size: 14px;
    font-weight: 600;
  }

  .analytics-summary {
    color: #b6c7ce;
    font-size: 14px;
    font-weight: 600;
  }

  .garden-stage {
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 700;
  }

  .garden-progress {
    flex-direction: row;
    align-items: center;
    gap: 5px;
  }

  .analytics-bars {
    flex-direction: row;
    align-items: center;
    gap: 5px;
  }

  .garden-progress-segment {
    flex-grow: 1;
    height: 6px;
    border-radius: 3px;
    background-color: #34434c;
  }

  .analytics-bars {
    justify-content: space-between;
    gap: 7px;
  }

  .analytics-day {
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .analytics-bar {
    width: 26px;
    height: 30px;
    border-radius: 6px;
    background-color: #34434c;
  }

  .analytics-day-label {
    color: #9eb4bf;
    font-size: 14px;
    font-weight: 700;
  }

  .analytics-day-count {
    color: #9eb4bf;
    font-size: 14px;
    font-weight: 700;
  }

  .task-actions {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .task-summary {
    color: #9eb4bf;
    font-size: 14px;
  }

  .create-button {
    margin-top: 2px;
  }

  .active-focus-banner {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 14px;
    background-color: #1a4240;
    border-width: 1px;
    border-color: #53cbb5;
  }

  .active-focus-pulse {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #53cbb5;
  }

  .active-focus-text {
    color: #7ce7d4;
    font-size: 14px;
    font-weight: 700;
  }

  .pip-quick-commands {
    flex-direction: column;
    gap: 6px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    background-color: #1b323c;
    border-width: 1px;
    border-color: #3b6470;
  }

  .pip-quick-label {
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 700;
  }

  .pip-chips {
    flex-direction: row;
    gap: 6px;
  }

  .pip-chip-btn {
    flex-grow: 1;
  }

  .task-modal {
    flex-direction: column;
    gap: 14px;
    padding-top: 22px;
    padding-bottom: 22px;
    padding-left: 26px;
    padding-right: 26px;
  }

  .modal-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .modal-title-group {
    flex-direction: column;
    gap: 2px;
  }

  .modal-eyebrow {
    color: #53cbb5;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.2px;
  }

  .modal-heading {
    color: #f3f6f7;
    font-size: 24px;
    font-weight: 700;
  }

  .modal-close-btn {
    width: 110px;
  }

  .modal-section {
    flex-direction: column;
    gap: 6px;
  }

  .modal-section-label {
    color: #9eb4bf;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.8px;
  }

  .field-container {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #3b5664;
    background-color: #18242d;
  }

  .modal-input-text {
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
  }

  .preset-chips {
    flex-direction: row;
    gap: 6px;
  }

  .chip-btn {
    flex-grow: 1;
  }

  .modal-row-split {
    flex-direction: row;
    gap: 16px;
  }

  .modal-column {
    flex-direction: column;
    flex-grow: 1;
    gap: 6px;
  }

  .modal-button-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }

  .prio-btn {
    flex-grow: 1;
  }

  .stepper-btn {
    width: 60px;
  }

  .duration-badge {
    align-items: center;
    justify-content: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 10px;
    background-color: #183942;
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 700;
  }

  .sched-btn {
    flex-grow: 1;
  }

  .modal-error-text {
    color: #ff7e7e;
    font-size: 14px;
    font-weight: 600;
  }

  .modal-actions {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    margin-top: 6px;
  }

  .modal-save-btn {
    flex-grow: 2;
  }

  .modal-cancel-btn {
    flex-grow: 1;
  }
  .ghost-desc {
    color: #7ea8f8;
    font-size: 14px;
    font-weight: 600;
  }

  .desk-height-controls {
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 8px;
    background-color: #17242c;
    border-width: 1px;
    border-color: #2e434f;
  }

  .desk-ctrl-btn {
    padding-left: 4px;
    padding-right: 4px;
  }

  .desk-height-text {
    color: #8ce2d2;
    font-size: 14px;
    font-weight: 700;
  }
</style>
<Panel class="dashboard">
  <div id="dashboard-content" class="content">
    <div class="topline">
      <div>
        <div class="brand">DESKMATE</div>
        <div id="day-date" class="date">TODAY</div>
        <span class="ghost-desc">GHOST DESKMATE: Quiet co-working presence</span>
      </div>
      <div id="active-focus-banner" class="active-focus-banner" style="display: none">
        <span class="active-focus-pulse"></span>
        <span id="active-focus-text" class="active-focus-text">FOCUSING: 25:00</span>
      </div>
      <div class="header-actions">
        <div class="desk-height-controls">
          <Button id="desk-down" class="desk-ctrl-btn"><ButtonLabel>- 5cm</ButtonLabel></Button>
          <span id="desk-height-text" class="desk-height-text">DESK: 0cm</span>
          <Button id="desk-up" class="desk-ctrl-btn"><ButtonLabel>+ 5cm</ButtonLabel></Button>
        </div>
        <div class="day-chip"><span id="companion-text" class="day-chip-text">GHOST COMPANION</span></div>
        <Button id="pip-toggle" class="pip-toggle">
          <span id="pip-launcher-orb" class="pip-launcher-orb"></span>
          <ButtonLabel>PIP</ButtonLabel>
        </Button>
      </div>
    </div>
    <div id="pip-panel" class="pip-panel" style="display: none">
      <div class="pip-heading">
        <div id="pip-orb" class="pip-orb">
          <div class="pip-face">
            <span class="pip-eye"></span>
            <span class="pip-eye"></span>
          </div>
        </div>
        <div class="pip-heading-copy">
          <span class="pip-name">PIP / LOCAL COMMAND MODE</span>
          <span id="pip-state" class="pip-state">READY / LOCAL MODE</span>
        </div>
        <Button id="pip-dismiss">
          <ButtonLabel>Hide</ButtonLabel>
        </Button>
      </div>
      <span id="pip-response" class="pip-response">Ask Pip to add a task, review today's plan, or create a schedule suggestion.</span>
      <span id="pip-transcript" class="pip-transcript">No request yet.</span>
      <span class="pip-disclosure">No AI provider is connected. Tap Listen only when ready; your browser may use its speech service to transcribe audio. Pip parses requests locally and sends no task data to an AI service.</span>
      <div class="pip-controls">
        <Button id="pip-listen" class="pip-control-button">
          <ButtonLabel id="pip-listen-label">Listen</ButtonLabel>
        </Button>
        <Button id="pip-text" class="pip-control-button">
          <ButtonLabel>Quick commands</ButtonLabel>
        </Button>
        <Button id="pip-recap" class="pip-control-button">
          <ButtonLabel>Daily recap</ButtonLabel>
        </Button>
      </div>
      <div id="pip-quick-commands" class="pip-quick-commands" style="display: none">
        <span class="pip-quick-label">QUICK LOCAL COMMANDS (TAP TO EXECUTE)</span>
        <div class="pip-chips">
          <Button id="pip-cmd-add" class="pip-chip-btn"><ButtonLabel>+ Add 30m Task</ButtonLabel></Button>
          <Button id="pip-cmd-schedule" class="pip-chip-btn"><ButtonLabel>Suggest Schedule</ButtonLabel></Button>
          <Button id="pip-cmd-focus" class="pip-chip-btn"><ButtonLabel>Start Focus</ButtonLabel></Button>
          <Button id="pip-cmd-rebalance" class="pip-chip-btn"><ButtonLabel>Rebalance Slots</ButtonLabel></Button>
          <Button id="pip-cmd-pending" class="pip-chip-btn"><ButtonLabel>Pending Tasks</ButtonLabel></Button>
          <Button id="pip-cmd-recap" class="pip-chip-btn"><ButtonLabel>Daily Recap</ButtonLabel></Button>
        </div>
      </div>
      <div id="pip-confirmation-row" class="pip-confirmation-row" style="display: none">
        <Button id="pip-confirm-schedule" class="pip-confirm-button">
          <ButtonLabel>Confirm schedule</ButtonLabel>
        </Button>
        <Button id="pip-cancel-schedule" class="pip-confirm-button">
          <ButtonLabel>Cancel</ButtonLabel>
        </Button>
      </div>
    </div>
    <div class="workload">
      <div class="workload-heading">
        <span class="workload-title">DAILY WORKLOAD</span>
        <span id="workload-value" class="workload-value">0h planned / 8h capacity</span>
      </div>
      <div class="load-track">
        <div id="load-segment-1" class="load-segment"></div>
        <div id="load-segment-2" class="load-segment"></div>
        <div id="load-segment-3" class="load-segment"></div>
        <div id="load-segment-4" class="load-segment"></div>
        <div id="load-segment-5" class="load-segment"></div>
        <div id="load-segment-6" class="load-segment"></div>
        <div id="load-segment-7" class="load-segment"></div>
        <div id="load-segment-8" class="load-segment"></div>
      </div>
      <div class="smart-status-row">
        <span id="workload-state" class="workload-state">UNDERLOADED</span>
        <span id="workload-detail" class="workload-detail">8h free / 0m complete / 0m pending</span>
      </div>
    </div>
    <div class="timeline-heading">
      <span class="timeline-title">TODAY'S TIMELINE</span>
      <span class="timeline-note">WORKING HOURS / 08:00 - 18:00</span>
    </div>
    <div class="time-markers">
      <span class="time-marker">08:00</span>
      <span class="time-marker">10:00</span>
      <span class="time-marker">12:00</span>
      <span class="time-marker">14:00</span>
      <span class="time-marker">16:00</span>
      <span class="time-marker">18:00</span>
    </div>
    <div class="timeline">
      <Button id="timeline-slot-480" class="time-slot">
        <ButtonLabel id="timeline-slot-label-480" class="slot-time">08:00 - 10:00</ButtonLabel>
        <span id="timeline-slot-content-480" class="slot-content">No tasks scheduled</span>
      </Button>
      <Button id="timeline-slot-600" class="time-slot">
        <ButtonLabel id="timeline-slot-label-600" class="slot-time">10:00 - 12:00</ButtonLabel>
        <span id="timeline-slot-content-600" class="slot-content">No tasks scheduled</span>
      </Button>
      <Button id="timeline-slot-720" class="time-slot">
        <ButtonLabel id="timeline-slot-label-720" class="slot-time">12:00 - 14:00</ButtonLabel>
        <span id="timeline-slot-content-720" class="slot-content">No tasks scheduled</span>
      </Button>
      <Button id="timeline-slot-840" class="time-slot">
        <ButtonLabel id="timeline-slot-label-840" class="slot-time">14:00 - 16:00</ButtonLabel>
        <span id="timeline-slot-content-840" class="slot-content">No tasks scheduled</span>
      </Button>
      <Button id="timeline-slot-960" class="time-slot">
        <ButtonLabel id="timeline-slot-label-960" class="slot-time">16:00 - 18:00</ButtonLabel>
        <span id="timeline-slot-content-960" class="slot-content">No tasks scheduled</span>
      </Button>
    </div>
    <span id="schedule-status" class="schedule-status">Select a task, then pick a timeline block.</span>
    <div class="smart-status-row">
      <span id="smart-status" class="smart-status">Checking today's plan...</span>
      <span id="schedule-suggestion" class="schedule-suggestion">Select a task for a slot suggestion</span>
    </div>
    <div class="schedule-controls">
      <Button id="schedule-earlier" class="schedule-button">
        <ButtonLabel>Earlier 30m</ButtonLabel>
      </Button>
      <Button id="schedule-later" class="schedule-button">
        <ButtonLabel>Later 30m</ButtonLabel>
      </Button>
      <Button id="schedule-apply-suggestion" class="schedule-button">
        <ButtonLabel>Apply suggestion</ButtonLabel>
      </Button>
      <Button id="schedule-dismiss-suggestion" class="schedule-button">
        <ButtonLabel>Dismiss</ButtonLabel>
      </Button>
      <Button id="schedule-clear" class="schedule-button">
        <ButtonLabel>Clear time</ButtonLabel>
      </Button>
    </div>
    <div class="selection-row">
      <span class="selection-label">SELECTED TASK</span>
      <span id="selected-task" class="selection-value">Choose a task card</span>
    </div>
    <div class="focus-stats">
      <span id="focus-statistics" class="focus-statistics">FOCUS TODAY 0m / 120m GOAL / 0 SESSIONS / TOTAL 0m</span>
      <span id="focus-history" class="focus-history">NO FOCUS HISTORY YET</span>
      <div class="focus-progress">
        <div id="focus-progress-1" class="focus-progress-segment"></div>
        <div id="focus-progress-2" class="focus-progress-segment"></div>
        <div id="focus-progress-3" class="focus-progress-segment"></div>
        <div id="focus-progress-4" class="focus-progress-segment"></div>
        <div id="focus-progress-5" class="focus-progress-segment"></div>
        <div id="focus-progress-6" class="focus-progress-segment"></div>
        <div id="focus-progress-7" class="focus-progress-segment"></div>
        <div id="focus-progress-8" class="focus-progress-segment"></div>
      </div>
    </div>
    <div class="insights-row">
      <div class="insight-card">
        <span class="insight-heading">PRODUCTIVITY GARDEN</span>
        <div class="garden-row">
          <div class="garden-plant">
            <div class="garden-crown">
              <span id="garden-flower" class="garden-flower" style="display: none"></span>
              <div id="garden-leaves-1" class="garden-leaves" style="display: none"><span class="garden-leaf"></span><span class="garden-leaf"></span></div>
              <div id="garden-leaves-2" class="garden-leaves" style="display: none"><span class="garden-leaf"></span><span class="garden-leaf"></span></div>
              <div id="garden-leaves-3" class="garden-leaves" style="display: none"><span class="garden-leaf"></span><span class="garden-leaf"></span></div>
              <div id="garden-leaves-4" class="garden-leaves" style="display: none"><span class="garden-leaf"></span><span class="garden-leaf"></span></div>
            </div>
            <div id="garden-stem" class="garden-stem"></div>
            <div class="garden-soil"></div>
          </div>
          <div class="garden-copy">
            <span id="garden-stage" class="garden-stage">SEED GARDEN</span>
            <span id="garden-details" class="garden-details">0 growth points / 0-day streak</span>
            <span id="garden-achievements" class="garden-achievements">Next: Sprout at 20 points</span>
          </div>
        </div>
        <div class="garden-progress">
          <div id="garden-progress-1" class="garden-progress-segment"></div>
          <div id="garden-progress-2" class="garden-progress-segment"></div>
          <div id="garden-progress-3" class="garden-progress-segment"></div>
          <div id="garden-progress-4" class="garden-progress-segment"></div>
        </div>
      </div>
      <div class="insight-card">
        <span class="insight-heading">7-DAY MOMENTUM</span>
        <div class="analytics-bars">
          <div class="analytics-day"><span id="analytics-day-label-1" class="analytics-day-label">MON</span><span id="analytics-bar-1" class="analytics-bar"></span><span id="analytics-day-count-1" class="analytics-day-count">0</span></div>
          <div class="analytics-day"><span id="analytics-day-label-2" class="analytics-day-label">TUE</span><span id="analytics-bar-2" class="analytics-bar"></span><span id="analytics-day-count-2" class="analytics-day-count">0</span></div>
          <div class="analytics-day"><span id="analytics-day-label-3" class="analytics-day-label">WED</span><span id="analytics-bar-3" class="analytics-bar"></span><span id="analytics-day-count-3" class="analytics-day-count">0</span></div>
          <div class="analytics-day"><span id="analytics-day-label-4" class="analytics-day-label">THU</span><span id="analytics-bar-4" class="analytics-bar"></span><span id="analytics-day-count-4" class="analytics-day-count">0</span></div>
          <div class="analytics-day"><span id="analytics-day-label-5" class="analytics-day-label">FRI</span><span id="analytics-bar-5" class="analytics-bar"></span><span id="analytics-day-count-5" class="analytics-day-count">0</span></div>
          <div class="analytics-day"><span id="analytics-day-label-6" class="analytics-day-label">SAT</span><span id="analytics-bar-6" class="analytics-bar"></span><span id="analytics-day-count-6" class="analytics-day-count">0</span></div>
          <div class="analytics-day"><span id="analytics-day-label-7" class="analytics-day-label">SUN</span><span id="analytics-bar-7" class="analytics-bar"></span><span id="analytics-day-count-7" class="analytics-day-count">0</span></div>
        </div>
        <span id="analytics-summary" class="analytics-summary">0 tasks / 0m focus / 0% complete</span>
      </div>
    </div>
    <div class="task-actions">
      <span id="task-summary" class="task-summary">3 / 6 tasks</span>
      <div class="focus-duration-controls">
        <Button id="focus-duration-down" class="focus-duration-button">
          <ButtonLabel>-5</ButtonLabel>
        </Button>
        <span id="focus-duration-value" class="focus-duration-value">25 MIN</span>
        <Button id="focus-duration-up" class="focus-duration-button">
          <ButtonLabel>+5</ButtonLabel>
        </Button>
      </div>
      <Button id="task-create" class="create-button">
        <ButtonLabel>Create task</ButtonLabel>
      </Button>
    </div>
  </div>
  <div id="task-modal" class="task-modal" style="display: none">
    <div class="modal-top">
      <div class="modal-title-group">
        <span class="modal-eyebrow">SPATIAL TASK BUILDER</span>
        <span id="modal-heading" class="modal-heading">Create New Task</span>
      </div>
      <Button id="modal-close-btn" class="modal-close-btn">
        <ButtonLabel>Cancel</ButtonLabel>
      </Button>
    </div>

    <div class="modal-section">
      <span class="modal-section-label">TASK TITLE (CHOOSE PRESET OR TYPE ON DESKTOP)</span>
      <div class="field-container">
        <span id="modal-input-title" class="modal-input-text">Deep Focus Sprint</span>
      </div>
      <div class="preset-chips">
        <Button id="preset-title-1" class="chip-btn"><ButtonLabel>Q4 Roadmap</ButtonLabel></Button>
        <Button id="preset-title-2" class="chip-btn"><ButtonLabel>Design Review</ButtonLabel></Button>
        <Button id="preset-title-3" class="chip-btn"><ButtonLabel>Code Sprint</ButtonLabel></Button>
        <Button id="preset-title-4" class="chip-btn"><ButtonLabel>Bug Triage</ButtonLabel></Button>
        <Button id="preset-title-5" class="chip-btn"><ButtonLabel>Team Sync</ButtonLabel></Button>
        <Button id="preset-title-6" class="chip-btn"><ButtonLabel>Documentation</ButtonLabel></Button>
      </div>
    </div>

    <div class="modal-section">
      <span class="modal-section-label">DESCRIPTION</span>
      <div class="field-container">
        <span id="modal-input-desc" class="modal-input-text">Deep work block and deliverables</span>
      </div>
      <div class="preset-chips">
        <Button id="preset-desc-1" class="chip-btn"><ButtonLabel>Deep work & milestones</ButtonLabel></Button>
        <Button id="preset-desc-2" class="chip-btn"><ButtonLabel>Review feedback</ButtonLabel></Button>
        <Button id="preset-desc-3" class="chip-btn"><ButtonLabel>Inbox zero</ButtonLabel></Button>
        <Button id="preset-desc-4" class="chip-btn"><ButtonLabel>Summary notes</ButtonLabel></Button>
      </div>
    </div>

    <div class="modal-row-split">
      <div class="modal-column">
        <span class="modal-section-label">PRIORITY</span>
        <div class="modal-button-row">
          <Button id="modal-prio-low" class="prio-btn"><ButtonLabel id="modal-prio-low-label">Low</ButtonLabel></Button>
          <Button id="modal-prio-med" class="prio-btn"><ButtonLabel id="modal-prio-med-label">Medium (Active)</ButtonLabel></Button>
          <Button id="modal-prio-high" class="prio-btn"><ButtonLabel id="modal-prio-high-label">High</ButtonLabel></Button>
        </div>
      </div>
      <div class="modal-column">
        <span class="modal-section-label">ESTIMATED DURATION</span>
        <div class="modal-button-row">
          <Button id="modal-dur-down" class="stepper-btn"><ButtonLabel>-15</ButtonLabel></Button>
          <span id="modal-dur-display" class="duration-badge">30 MIN</span>
          <Button id="modal-dur-up" class="stepper-btn"><ButtonLabel>+15</ButtonLabel></Button>
        </div>
      </div>
    </div>

    <div class="modal-section">
      <span class="modal-section-label">SCHEDULE TIMELINE (WORKING HOURS 08:00 - 18:00)</span>
      <div class="modal-button-row">
        <Button id="modal-sched-none" class="sched-btn"><ButtonLabel id="modal-sched-none-label">Unscheduled (Active)</ButtonLabel></Button>
        <Button id="modal-sched-08" class="sched-btn"><ButtonLabel id="modal-sched-08-label">08:00</ButtonLabel></Button>
        <Button id="modal-sched-10" class="sched-btn"><ButtonLabel id="modal-sched-10-label">10:00</ButtonLabel></Button>
        <Button id="modal-sched-12" class="sched-btn"><ButtonLabel id="modal-sched-12-label">12:00</ButtonLabel></Button>
        <Button id="modal-sched-14" class="sched-btn"><ButtonLabel id="modal-sched-14-label">14:00</ButtonLabel></Button>
        <Button id="modal-sched-16" class="sched-btn"><ButtonLabel id="modal-sched-16-label">16:00</ButtonLabel></Button>
      </div>
    </div>

    <span id="modal-error-message" class="modal-error-text" style="display: none">Error message</span>

    <div class="modal-actions">
      <Button id="modal-save-btn" class="modal-save-btn">
        <ButtonLabel>Save Task</ButtonLabel>
      </Button>
      <Button id="modal-cancel-btn" class="modal-cancel-btn">
        <ButtonLabel>Cancel</ButtonLabel>
      </Button>
    </div>
  </div>
</Panel>